<header>
  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <div class="header__menu">
    {% for link in section.settings.menu.links %}
      {{ link.title | link_to: link.url }}
    {% endfor %}
  </div>

  <div class="header__icons">
    {%- if shop.customer_accounts_enabled -%}
      {%- assign account_label = 'header.account' | t -%}
      {% render 'icon-button', icon: 'account', label: account_label, url: routes.account_url %}
    {%- endif -%}

    {%- liquid
      assign cart_label = 'header.cart' | t
      if cart.item_count > 0
        assign cart_label = 'header.cart_count' | t: count: cart.item_count
      endif
    -%}
    {% render 'icon-button', icon: 'cart', label: cart_label, url: routes.cart_url, badge: cart.item_count %}
  </div>
</header>

{% stylesheet %}
  header {
    height: 5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  header a {
    text-decoration: none;
    color: var(--color-foreground);
  }
  header .header__menu,
  header .header__icons {
    display: flex;
    gap: 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
