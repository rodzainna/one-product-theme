{% comment %}
  The site header: logo or store name, the menu, and the account and cart icons. The header
  group makes it sticky (the Sticky header theme setting).
  https://shopify.dev/docs/storefronts/themes/architecture/section-groups
{% endcomment %}

<header class="site-header full-width color-{{ section.settings.color_scheme }}">
  <div class="site-header__inner">
    {%- if section.settings.menu.links.size > 0 -%}
      <span class="site-header__menu-button">
        {%- assign menu_label = 'header.open_menu' | t -%}
        {%- render 'icon-button',
          icon: 'menu',
          label: menu_label,
          attributes: 'data-dialog-open="MenuDrawer" aria-haspopup="dialog"'
        -%}
      </span>
    {%- endif -%}

    {%- if section.settings.logo != blank -%}
      {%- assign logo_file_width = section.settings.logo_width | times: 3 -%}
      {%- assign logo_sizes = section.settings.logo_width | append: 'px' -%}
      <div class="site-header__logo-image" style="--logo-width: {{ section.settings.logo_width }}px">
        {%- render 'image',
          image: section.settings.logo,
          url: routes.root_url,
          alt: shop.name,
          width: logo_file_width,
          sizes: logo_sizes,
          loading: 'eager'
        -%}
      </div>
    {%- else -%}
      <a class="site-header__logo site-header__name" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
    {%- endif -%}

    {%- if section.settings.menu.links.size > 0 -%}
      {%- assign bar_prefix = 'Menu-' | append: section.id -%}
      <nav class="site-header__nav" aria-label="{{ 'header.menu' | t }}">
        {%- render 'menu-links', links: section.settings.menu.links, id_prefix: bar_prefix, variant: 'bar' -%}
      </nav>
    {%- endif -%}

    <div class="site-header__tools">
      {%- if section.settings.show_search -%}
        {%- assign search_label = 'header.search' | t -%}
        {%- comment -%} A link, so it still reaches the search page if the script doesn't load. {%- endcomment -%}
        {%- render 'icon-button',
          icon: 'search',
          label: search_label,
          url: routes.search_url,
          attributes: 'data-dialog-open="SearchModal" aria-haspopup="dialog"'
        -%}
      {%- endif -%}

      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        {%- assign account_label = 'header.account' | t -%}
        {%- assign account_menu = section.settings.customer_account_menu.handle
          | default: 'customer-account-main-menu'
        -%}
        <shopify-account class="site-header__account" menu="{{ account_menu | escape }}">
          <span slot="signed-out-avatar" class="site-header__account-avatar">
            {%- render 'icon', name: 'account' -%}
            <span class="visually-hidden">{{ account_label }}</span>
          </span>
        </shopify-account>
        {%- comment -%} A plain link to the account page shows until the component has loaded, and stays if it never does. {%- endcomment -%}
        <span class="site-header__account-link">
          {%- render 'icon-button', icon: 'account', label: account_label, url: routes.account_url -%}
        </span>
      {%- endif -%}

      {%- liquid
        assign cart_label = 'header.cart' | t
        if cart.item_count > 0
          assign cart_label = 'header.cart_count' | t: count: cart.item_count
        endif
      -%}
      <span id="CartIcon-{{ section.id }}" data-cart-region data-cart-icon>
        {%- render 'icon-button', icon: 'cart', label: cart_label, url: routes.cart_url, badge: cart.item_count -%}
      </span>
    </div>
  </div>
</header>

{%- if section.settings.show_search -%}
  {%- render 'search-modal', id: 'SearchModal' -%}
{%- endif -%}

{%- if section.settings.menu.links.size > 0 -%}
  {%- capture drawer_menu -%}
    <nav aria-label="{{ 'header.menu' | t }}">
      {%- assign drawer_prefix = 'Drawer-' | append: section.id -%}
      {%- render 'menu-links', links: section.settings.menu.links, id_prefix: drawer_prefix, variant: 'drawer' -%}
    </nav>
  {%- endcapture -%}
  {%- assign drawer_title = 'header.drawer_title' | t -%}
  {%- render 'dialog',
    id: 'MenuDrawer',
    title: drawer_title,
    content: drawer_menu,
    class: 'dialog--drawer dialog--drawer-start'
  -%}
  <script src="{{ 'header-menu.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  .site-header {
    display: grid;
    grid-template-columns: var(--content-grid);
    border-block-end: 1px solid var(--color-border);
  }
  .site-header__inner {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-m);
    min-block-size: 4rem;
  }
  .site-header__logo {
    max-inline-size: 40%;
    color: inherit;
    text-decoration: none;
  }
  .site-header__logo-image {
    inline-size: var(--logo-width);
  }
  .site-header__name {
    font-family: var(--font-heading);
    font-size: var(--text-h4);
    font-weight: var(--weight-heading);
    line-height: var(--leading-none);
    overflow-wrap: anywhere;
  }
  .site-header__nav {
    flex: 1 1 auto;
  }
  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-inline-start: auto;
  }
  .site-header__account {
    --shopify-account-avatar-size: var(--control-h);
    --shopify-account-color-background: var(--color-background);
    --shopify-account-color-text: var(--color-foreground);
    --shopify-account-color-accent: var(--color-accent);
    --shopify-account-font-body: var(--font-body);
    --shopify-account-font-heading: var(--font-heading);
    --shopify-account-radius-base: var(--radius-card);
  }
  .site-header__account::part(signed-out-avatar) {
    padding: 0;
    border-radius: var(--radius-full);
  }
  .site-header__account::part(signed-out-avatar):focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  .site-header__account-avatar {
    display: grid;
    place-items: center;
    width: var(--control-h);
    height: var(--control-h);
  }
  .site-header__account:not(:defined),
  .site-header__account:defined + .site-header__account-link {
    display: none;
  }
  /* Phones: the menu button opens the drawer instead of the row of links. */
  .site-header__menu-button {
    margin-inline-start: calc(var(--space-xs) * -1);
  }
  @media (min-width: 900px) {
    .site-header__menu-button {
      display: none;
    }
  }
  @media (max-width: 899.98px) {
    .site-header__inner {
      flex-wrap: nowrap;
    }
    .site-header__logo {
      max-inline-size: 55%;
    }
    .site-header__nav {
      display: none;
    }
  }
  /* Without scripting the drawer can't open, so the links wrap onto a row below the logo. */
  @media (max-width: 899.98px) and (scripting: none) {
    .site-header__inner {
      flex-wrap: wrap;
    }
    .site-header__menu-button {
      display: none;
    }
    .site-header__nav {
      display: block;
      order: 3;
      flex-basis: 100%;
    }
    .site-header__nav .menu--bar {
      justify-content: flex-start;
    }
  }
  /* Short desktop windows give the page back some height. */
  @media (min-width: 900px) and (max-height: 800px) {
    .site-header__inner {
      min-block-size: 3.375rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo",
      "info": "t:info.logo"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:labels.show_search",
      "info": "t:info.show_search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:labels.show_account",
      "info": "t:info.show_account",
      "default": true
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu",
      "visible_if": "{{ section.settings.show_account }}"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 40,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "t:labels.logo_width",
      "default": 120,
      "visible_if": "{{ section.settings.logo != blank }}"
    }
  ]
}
{% endschema %}
