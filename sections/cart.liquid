{% comment %}
  The /cart page. Without JavaScript it's a plain form: Update saves quantities and the note,
  Remove links drop a line, and Check out saves then goes to checkout. assets/cart.js saves
  each change live instead and re-renders this section.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

{%- assign form_id = 'CartForm-' | append: section.id -%}

<div class="cart" id="CartPage-{{ section.id }}" data-cart-region>
  <h1 class="cart__title h2" tabindex="-1" data-cart-focus>{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="cart__empty">
      <p>{{ 'cart.empty' | t }}</p>
      {%- assign continue_label = 'cart.continue_shopping' | t -%}
      {% render 'button', label: continue_label, url: routes.root_url, variant: 'secondary' %}
    </div>
  {%- else -%}
    {% render 'cart-form', form_id: form_id, id_prefix: section.id %}

    <div class="cart__summary">
      {%- if settings.cart_note -%}
        {%- liquid
          assign note_label = 'cart.note' | t
          assign note_id = 'CartNote-' | append: section.id
          assign note_attributes = 'form="' | append: form_id | append: '" data-cart-note data-cart-keep'
        -%}
        {% render 'input',
          id: note_id,
          label: note_label,
          type: 'textarea',
          name: 'note',
          value: cart.note,
          rows: 3,
          attributes: note_attributes
        %}
      {%- endif -%}
      {% render 'cart-summary', form_id: form_id, show_dynamic_checkout: settings.cart_dynamic_checkout %}
    </div>
  {%- endif -%}
</div>

<script src="{{ 'cart.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .cart {
    --cart-summary-min: 18rem;
    --cart-summary-max: 24rem;
    display: grid;
    gap: var(--space-m);
    align-items: start;
    padding-block: var(--space-l) var(--space-xl);
  }

  .cart__title {
    margin: 0;
  }

  .cart__empty {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .cart__empty p {
    margin: 0;
  }

  .cart__summary {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-m);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  @media (min-width: 900px) {
    .cart {
      grid-template-columns: minmax(0, 1fr) minmax(var(--cart-summary-min), var(--cart-summary-max));
      column-gap: var(--space-xl);
    }

    .cart__title,
    .cart__empty {
      grid-column: 1 / -1;
    }

    .cart__summary {
      position: sticky;
      top: calc(var(--header-offset, 0px) + var(--space-m));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
