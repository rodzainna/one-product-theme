{% comment %}
  This section is used in the article template to render the article page, which
  displays the full content of the blog post and can optionally include a
  comments section for customers (not shown in this example).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

{% if article.image %}
  {% render 'image', image: article.image, preload: true %}
{% endif %}

<h1>{{ article.title }}</h1>

{% assign date = article.published_at | time_tag: format: 'date' %}
<p>{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>

{% render 'rte', content: article.content %}

{% if blog.comments_enabled? %}
  <h2>{{ 'blog.article_comments' | t }}</h2>

  <div id="comments">
    {% paginate article.comments by 10 %}
      {% for comment in article.comments %}
        <div>
          <p>{{ comment.author }}</p>
          <p>
            {{- comment.created_at | time_tag: format: 'date' -}}
          </p>
          {% render 'rte', content: comment.content %}
        </div>
      {% endfor %}

      {{ paginate | default_pagination: anchor: 'comments' }}
    {% endpaginate %}
  </div>

  {% form 'new_comment', article %}
    <h2>{{ 'blog.comment_form_title' | t }}</h2>

    {%- liquid
      assign comment_prefix = 'CommentForm-' | append: section.id
      if form.errors
        render 'message', type: 'error', errors: form.errors, id_prefix: comment_prefix
      elsif form.posted_successfully?
        if blog.moderated?
          assign posted_text = 'blog.comment_posted_moderated' | t
        else
          assign posted_text = 'blog.comment_posted' | t
        endif
        render 'message', type: 'success', text: posted_text, focus: true
      endif

      assign name_label = 'blog.comment_form_name' | t
      assign email_label = 'blog.comment_form_email' | t
      assign body_label = 'blog.comment_form_body' | t
      assign submit_label = 'blog.comment_form_submit' | t
      assign author_id = comment_prefix | append: '-author'
      assign email_id = comment_prefix | append: '-email'
      assign body_id = comment_prefix | append: '-body'
    -%}

    {% render 'input',
      id: author_id,
      label: name_label,
      name: 'comment[author]',
      value: form.author,
      autocomplete: 'name',
      required: true,
      errors: form.errors,
      field: 'author'
    %}
    {% render 'input',
      id: email_id,
      label: email_label,
      type: 'email',
      name: 'comment[email]',
      value: form.email,
      autocomplete: 'email',
      required: true,
      errors: form.errors,
      field: 'email'
    %}
    {% render 'input',
      id: body_id,
      label: body_label,
      type: 'textarea',
      name: 'comment[body]',
      value: form.body,
      required: true,
      errors: form.errors,
      field: 'body'
    %}
    {% render 'button', label: submit_label, type: 'submit' %}
  {% endform %}
{% endif %}

{% schema %}
{
  "name": "t:general.article",
  "settings": []
}
{% endschema %}
