{% comment %}
  The page shown for an address that doesn't exist: the message, a search field and links to the
  store's products and home page, centred in the screen.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/404
{% endcomment %}

{%- liquid
  assign shop_label = '404.back_to_shopping' | t
  assign home_label = '404.home' | t
-%}

{%- assign search_id = 'Search-' | append: section.id -%}

<div class="not-found section-full">
  <p class="not-found__code" aria-hidden="true">404</p>
  <h1 class="not-found__title h2">{{ '404.title' | t }}</h1>
  <p class="not-found__text">{{ '404.not_found' | t }}</p>

  {% render 'search-form', id: search_id, class: 'not-found__search' %}

  <div class="not-found__links">
    {% render 'button', label: shop_label, url: routes.all_products_collection_url %}
    {% render 'button', label: home_label, url: routes.root_url, variant: 'secondary' %}
  </div>
</div>

{% stylesheet %}
  .not-found {
    display: grid;
    gap: var(--space-m);
    align-content: center;
    justify-items: center;
    padding-block: var(--space-l) var(--space-xl);
    text-align: center;
  }

  .not-found__code {
    margin: 0;
    color: var(--color-foreground-muted);
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
  }

  .not-found__title,
  .not-found__text {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .not-found__text {
    color: var(--color-foreground-muted);
  }

  .not-found__search {
    inline-size: 100%;
    max-inline-size: 40rem;
    margin-block-start: var(--space-s);
  }

  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
