{% comment %}
  The list of collections: a grid of collection cards with page links, or a message and a way
  to the store's products when there are none.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/list-collections
{% endcomment %}

{%- paginate collections by 12 -%}
  <div class="collections">
    <h1 class="collections__title h2">{{ 'collections.title' | t }}</h1>

    {%- if paginate.items == 0 -%}
      <div class="collections__empty">
        <p>{{ 'collections.empty' | t }}</p>
        {%- assign shop_label = 'collections.shop_all' | t -%}
        {% render 'button', label: shop_label, url: routes.all_products_collection_url, variant: 'secondary' %}
      </div>
    {%- elsif paginate.current_page > paginate.pages -%}
      <div class="collections__empty">
        <p>{{ 'collections.past_end' | t }}</p>
        {%- assign first_label = 'collection.first_page' | t -%}
        {% render 'button', label: first_label, url: routes.collections_url, variant: 'secondary' %}
      </div>
    {%- else -%}
      <ul class="card-grid">
        {%- for collection in collections -%}
          {%- liquid
            assign card_loading = 'lazy'
            if forloop.index <= 4
              assign card_loading = 'eager'
            endif
          -%}
          <li>
            {% render 'collection-card',
              collection: collection,
              sizes: '(min-width: 900px) 22vw, (min-width: 600px) 30vw, 44vw',
              loading: card_loading
            %}
          </li>
        {%- endfor -%}
      </ul>

      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% stylesheet %}
  .collections {
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-l) var(--space-xl);
  }

  .collections__title {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .collections__empty {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .collections__empty p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": []
}
{% endschema %}
