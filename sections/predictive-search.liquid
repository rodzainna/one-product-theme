{% comment %}
  The results inside the header's search modal. assets/predictive-search.js fetches this section
  from /search/suggest as someone types and swaps it in.
  https://shopify.dev/docs/storefronts/themes/navigation-search/search/predictive-search
{% endcomment %}

{%- if predictive_search.performed -%}
  {%- liquid
    assign terms = predictive_search.terms | escape
    assign found = predictive_search.resources
    assign result_count = found.queries.size | plus: found.products.size | plus: found.collections.size | plus: found.pages.size | plus: found.articles.size
    assign groups = 'queries,products,collections,pages,articles' | split: ','
    assign option_count = 0

    if result_count == 0
      assign status = 'search.predictive.no_results' | t: terms: terms
    else
      assign status = 'search.predictive.results_count' | t: count: result_count
    endif
  -%}

  <div id="predictive-search-results" class="predictive" data-summary="{{ status | escape_once }}">
    {%- if result_count == 0 -%}
      <p class="predictive__empty">{{ status }}</p>
    {%- endif -%}

    <div
      class="predictive__list"
      id="predictive-search-listbox"
      role="listbox"
      aria-label="{{ 'search.predictive.results' | t }}"
    >
      {%- for group in groups -%}
        {%- assign items = found[group] -%}
        {%- if items.size > 0 -%}
          {%- assign heading_id = 'predictive-search-' | append: group -%}
          {%- assign heading_key = 'search.predictive.' | append: group -%}
          <div role="group" aria-labelledby="{{ heading_id }}">
            <p class="predictive__heading" id="{{ heading_id }}">{{ heading_key | t }}</p>
            {%- for item in items -%}
              {%- assign option_count = option_count | plus: 1 -%}
              {%- if group == 'products' -%}
                <a
                  class="predictive__option predictive__product"
                  id="predictive-search-option-{{ option_count }}"
                  role="option"
                  tabindex="-1"
                  href="{{ item.url }}"
                >
                  <div class="predictive__thumb">
                    {%- if item.featured_media -%}
                      {% render 'image',
                        image: item.featured_media,
                        alt: '',
                        sizes: '48px',
                        aspect_ratio: '1',
                        width: 144
                      %}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'predictive__placeholder' }}
                    {%- endif -%}
                  </div>
                  <div class="predictive__text">
                    <span class="predictive__title">{{ item.title | escape }}</span>
                    {% render 'price', variant: item.selected_or_first_available_variant, range_product: item %}
                  </div>
                </a>
              {%- else -%}
                <a
                  class="predictive__option"
                  id="predictive-search-option-{{ option_count }}"
                  role="option"
                  tabindex="-1"
                  href="{{ item.url }}"
                >
                  {%- if group == 'queries' -%}
                    {{ item.styled_text }}
                  {%- else -%}
                    {{ item.title | escape }}
                  {%- endif -%}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- assign option_count = option_count | plus: 1 -%}
      <a
        class="predictive__option predictive__all"
        id="predictive-search-option-{{ option_count }}"
        role="option"
        tabindex="-1"
        href="{{ routes.search_url }}"
        data-search-all
      >
        {{- 'search.predictive.search_for' | t: terms: terms -}}
      </a>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .predictive__empty {
    margin: 0;
    padding: var(--space-s) var(--space-xs);
    color: var(--color-foreground-muted);
  }

  .predictive__heading {
    margin: 0;
    padding: var(--space-m) var(--space-xs) var(--space-2xs);
    color: var(--color-foreground-muted);
    font-size: var(--text-caption);
    font-weight: var(--weight-ui);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .predictive__option {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    min-block-size: var(--control-h);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-input);
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  @media (hover: hover) {
    .predictive__option:hover {
      background: var(--color-hover);
    }
  }

  /* The field keeps focus, so the option it points at is marked here. */
  .predictive__option[aria-selected='true'] {
    background: var(--color-hover);
    outline: var(--focus-ring);
    outline-offset: calc(-1 * var(--focus-offset));
  }

  .predictive__option mark {
    background: none;
    color: inherit;
    font-weight: var(--weight-ui);
  }

  .predictive__thumb {
    flex: none;
    inline-size: 3rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .predictive__placeholder {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1;
    background: var(--color-border);
    fill: var(--color-foreground-muted);
  }

  .predictive__text {
    display: grid;
    gap: var(--space-2xs);
    min-inline-size: 0;
  }

  .predictive__title {
    font-weight: var(--weight-ui);
  }

  .predictive__all {
    margin-block-start: var(--space-s);
    border-block-start: 1px solid var(--color-border);
    border-radius: 0 0 var(--radius-input) var(--radius-input);
    font-weight: var(--weight-ui);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.predictive_search"
}
{% endschema %}
