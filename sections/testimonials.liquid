{% comment %}
  A full-screen set of testimonial cards: up to six, three across on wide screens, with a heading
  and an optional help line and link to the reviews.
  https://shopify.dev/docs/storefronts/themes/architecture/blocks/theme-blocks
{% endcomment %}

{%- liquid
  assign columns = section.blocks.size
  if columns > 3
    assign columns = 3
  endif
  assign columns_mid = 1
  assign odd = section.blocks.size | modulo: 2
  if odd == 0
    assign columns_mid = 2
  endif

  assign has_link = false
  if section.settings.link != blank and section.settings.link_label != blank
    assign has_link = true
  endif
-%}
{%- if section.blocks.size == 0 -%}
  <div data-empty></div>
{%- else -%}
  <div
    class="testimonials full-width section-full color-{{ section.settings.color_scheme }}"
    style="--testimonials-columns: {{ columns }}; --testimonials-columns-mid: {{ columns_mid }};"
  >
    <div class="testimonials__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="testimonials__heading">{{ section.settings.heading | escape }}</h2>
      {%- else -%}
        <h2 class="testimonials__heading visually-hidden">{{ 'testimonials.heading' | t }}</h2>
      {%- endif -%}
      <div class="testimonials__list" role="list">
        {% content_for 'blocks' %}
      </div>
      {%- if section.settings.text != blank or has_link -%}
        <p class="testimonials__help">
          {%- if section.settings.text != blank -%}
            {{ section.settings.text | escape }}
          {%- endif -%}
          {%- if has_link -%}
            <a class="testimonials__link" href="{{ section.settings.link | escape }}">
              {{- section.settings.link_label | escape -}}
            </a>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .testimonials {
    display: grid;
    grid-template-columns: var(--content-grid);
    align-items: center;
    width: 100%;
  }
  .testimonials__content {
    --testimonials-clearance: calc(var(--space-xl) + var(--sticky-bar-h, 0px));
    grid-column: 2;
    padding-block: var(--space-xl) var(--testimonials-clearance);
    /* Clears the section dots on narrow screens. */
    padding-inline-end: var(--space-m);
  }
  .testimonials__heading,
  .testimonials__help {
    margin: 0;
  }
  .testimonials__list {
    display: grid;
    gap: var(--space-m);
    margin: var(--space-l) 0;
  }
  .testimonials__list > * {
    display: grid;
  }
  .testimonials__list > * > .card {
    height: 100%;
  }
  .testimonials__help {
    color: var(--color-foreground-muted);
  }
  .testimonials__link {
    display: block;
    width: fit-content;
    min-height: var(--target-min);
    color: var(--color-foreground);
    font-weight: var(--weight-ui);
  }
  @media (min-width: 700px) {
    .testimonials__content {
      padding-inline-end: 0;
    }
    .testimonials__list {
      grid-template-columns: repeat(var(--testimonials-columns-mid), minmax(0, 1fr));
    }
  }
  @media (min-width: 900px) {
    .testimonials__list {
      grid-template-columns: repeat(var(--testimonials-columns), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.testimonials",
  "blocks": [{ "type": "_testimonial" }],
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "What people say"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.help_text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "Read all reviews"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "presets": [
    {
      "name": "t:general.testimonials",
      "blocks": [{ "type": "_testimonial" }, { "type": "_testimonial" }, { "type": "_testimonial" }]
    }
  ]
}
{% endschema %}
