{% comment %}
  A full-screen list of features (icon, title, text) over an optional background image.
  https://shopify.dev/docs/storefronts/themes/architecture/blocks/theme-blocks
{% endcomment %}

{%- liquid
  assign image = section.settings.background_image
  assign parallax = false
  if section.settings.parallax and image != blank
    assign parallax = true
  endif

  assign columns = section.blocks.size
  assign columns_mid = 2
  if columns > 4
    assign columns = 3
  endif
  if section.blocks.size < 3
    assign columns_mid = section.blocks.size
  elsif section.blocks.size == 3
    assign columns_mid = 3
  endif
-%}
{%- if section.blocks.size == 0 -%}
  <div data-empty></div>
{%- else -%}
  <div
    class="features full-width section-full color-{{ section.settings.color_scheme }}{% if parallax %} parallax{% endif %}"
    style="--features-overlay: {{ section.settings.overlay }}%; --features-icon-mobile: {{ section.settings.icon_size_mobile }}px; --features-icon-desktop: {{ section.settings.icon_size_desktop }}px; --features-columns: {{ columns }}; --features-columns-mid: {{ columns_mid }};"
  >
    {%- if image != blank -%}
      <div class="features__media{% if parallax %} parallax__media{% endif %}" aria-hidden="true">
        {% render 'image', image: image, alt: '', class: 'features__image' %}
      </div>
    {%- endif -%}

    <div class="features__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="features__heading">{{ section.settings.heading | escape }}</h2>
      {%- else -%}
        <h2 class="features__heading visually-hidden">{{ 'features.heading' | t }}</h2>
      {%- endif -%}
      <div class="features__list" role="list">
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .features {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: var(--content-grid);
    align-items: center;
    width: 100%;
  }
  .features__media {
    position: absolute;
    inset: 0;
  }
  .features__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-background) var(--features-overlay), transparent);
  }
  .features__image,
  .features__media .image > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .features__content {
    position: relative;
    grid-column: 2;
    padding-block: var(--space-2xl);
    /* Clears the section dots on narrow screens. */
    padding-inline-end: var(--space-m);
  }
  .features__heading {
    margin: 0;
  }
  .features__list {
    display: grid;
    gap: var(--space-l);
    margin: var(--space-l) 0 0;
  }
  @media (min-width: 700px) {
    .features__content {
      padding-inline-end: 0;
    }
    .features__list {
      grid-template-columns: repeat(var(--features-columns-mid), minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .features__list {
      grid-template-columns: repeat(var(--features-columns), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.features",
  "blocks": [{ "type": "_feature" }],
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "t:labels.overlay",
      "info": "t:info.overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "t:labels.parallax",
      "info": "t:info.parallax",
      "default": true,
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "header",
      "content": "t:labels.icons"
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "t:labels.icon_size_mobile",
      "info": "t:info.icon_size",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "icon_size_desktop",
      "label": "t:labels.icon_size_desktop",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Why choose us"
    }
  ],
  "presets": [
    {
      "name": "t:general.features",
      "blocks": [
        { "type": "_feature", "settings": { "icon": "leaf", "title": "First feature" } },
        { "type": "_feature", "settings": { "icon": "shield-check", "title": "Second feature" } },
        { "type": "_feature", "settings": { "icon": "truck", "title": "Third feature" } },
        { "type": "_feature", "settings": { "icon": "heart", "title": "Fourth feature" } }
      ]
    }
  ]
}
{% endschema %}
