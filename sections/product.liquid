{% comment %}
  The product page's buy box (snippets/buy-box.liquid). The blocks read the template's
  product through closest.product.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{%- liquid
  assign square = false
  if section.settings.media_ratio == 'square'
    assign square = true
  endif
-%}
{%- capture blocks -%}{% content_for 'blocks' %}{%- endcapture -%}
{% render 'buy-box', product: product, blocks: blocks, section_id: section.id, square: square, preload: true %}

{% schema %}
{
  "name": "t:general.product",
  "blocks": [
    { "type": "_product-title" },
    { "type": "_product-price" },
    { "type": "_product-description" },
    { "type": "_variant-picker" },
    { "type": "_buy-buttons" },
    { "type": "_product-rating" },
    { "type": "_pickup-availability" },
    { "type": "_custom-liquid" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "media_ratio",
      "label": "t:labels.media_ratio",
      "info": "t:info.media_ratio",
      "options": [
        { "value": "square", "label": "t:options.media_ratio.square" },
        { "value": "original", "label": "t:options.media_ratio.original" }
      ],
      "default": "square"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
