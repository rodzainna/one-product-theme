{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-images">
  {% for image in product.images %}
    {% render 'image', class: 'product-image', image: image %}
  {% endfor %}
</div>

<div class="product-info">
  <h1>{{ product.title }}</h1>
  <p>{{ product.price | money }}</p>
  {% render 'rte', content: product.description %}
</div>

<div class="product-form">
  {% form 'product', product %}
    {% assign current_variant = product.selected_or_first_available_variant %}

    {%- if product.has_only_default_variant -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}">
    {%- else -%}
      {%- liquid
        assign sold_out_label = 'products.product.sold_out' | t
        assign variant_label = product.options | join: ' / '
        assign variant_id = 'Product-variant-' | append: section.id
      -%}
      {%- capture variant_options -%}
        {%- for variant in product.variants -%}
          <option
            value="{{ variant.id }}"
            {% if variant == current_variant %}
              selected
            {% endif %}
          >
            {{- variant.title | escape }} - {{ variant.price | money -}}
            {%- unless variant.available %} ({{ sold_out_label }}){% endunless -%}
          </option>
        {%- endfor -%}
      {%- endcapture -%}
      {% render 'select', id: variant_id, label: variant_label, name: 'id', options_html: variant_options %}
    {%- endif -%}

    {%- if current_variant.selling_plan_allocations.size > 0 -%}
      {%- liquid
        assign plan_prefix = 'Product-plan-' | append: section.id
        assign one_time_id = plan_prefix | append: '-once'
        assign one_time_label = 'products.product.one_time_purchase' | t
        assign one_time_price = current_variant.price | money | strip_html
        assign selected_plan_id = current_variant.selected_selling_plan_allocation.selling_plan.id
        if selected_plan_id == blank and product.requires_selling_plan
          assign selected_plan_id = current_variant.selling_plan_allocations.first.selling_plan.id
        endif
        assign one_time_checked = false
        if selected_plan_id == blank
          assign one_time_checked = true
        endif
      -%}
      <fieldset class="choice-group choice-group--cards">
        <legend>{{ 'products.product.purchase_options' | t }}</legend>
        {%- unless product.requires_selling_plan -%}
          {% render 'radio',
            id: one_time_id,
            name: 'selling_plan',
            value: '',
            label: one_time_label,
            hint: one_time_price,
            checked: one_time_checked,
            variant: 'card'
          %}
        {%- endunless -%}
        {%- for allocation in current_variant.selling_plan_allocations -%}
          {%- liquid
            assign plan = allocation.selling_plan
            assign plan_id = plan_prefix | append: '-' | append: plan.id
            assign plan_price = allocation.price | money | strip_html
            assign plan_checked = false
            if plan.id == selected_plan_id
              assign plan_checked = true
            endif
          -%}
          {% render 'radio',
            id: plan_id,
            name: 'selling_plan',
            value: plan.id,
            label: plan.name,
            hint: plan_price,
            checked: plan_checked,
            variant: 'card'
          %}
        {%- endfor -%}
      </fieldset>
    {%- endif -%}

    <input type="text" name="quantity" min="1" value="1">

    {%- assign add_label = 'products.product.add_to_cart' | t -%}
    {% render 'button', label: add_label, type: 'submit', name: 'add' %}
    {{ form | payment_button }}
  {% endform %}
</div>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
