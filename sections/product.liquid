{% comment %}
  The product page's buy box: the media gallery on the left and blocks on the right from 900px,
  stacked on phones. The blocks read the product through closest.product.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="buy-box">
  {%- liquid
    assign square = false
    if section.settings.media_ratio == 'square'
      assign square = true
    endif
    assign gallery_id = 'Gallery-' | append: section.id
  -%}
  {% render 'product-gallery', product: product, id: gallery_id, square: square %}

  <div class="buy-box__info">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .buy-box {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
    padding-block: var(--space-xl);
  }

  .buy-box__info {
    display: grid;
    gap: var(--space-s);
  }

  @media (min-width: 900px) {
    .buy-box {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }

    /* Stays on the right when the product has no media. */
    .buy-box__info {
      grid-column: -2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "blocks": [
    { "type": "_product-title" },
    { "type": "_product-price" },
    { "type": "_product-description" },
    { "type": "_variant-picker" },
    { "type": "_buy-buttons" },
    { "type": "_product-rating" },
    { "type": "_pickup-availability" },
    { "type": "_custom-liquid" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "media_ratio",
      "label": "t:labels.media_ratio",
      "info": "t:info.media_ratio",
      "options": [
        { "value": "square", "label": "t:options.media_ratio.square" },
        { "value": "original", "label": "t:options.media_ratio.original" }
      ],
      "default": "square"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
