{% comment %}
  The product page's buy box: images on the left and blocks on the right from 900px,
  stacked on phones. The blocks read the product through closest.product.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="buy-box">
  <div class="buy-box__media">
    {%- assign images = product.media | where: 'media_type', 'image' -%}
    {%- for media in images -%}
      {% render 'image',
        class: 'product-image',
        image: media,
        sizes: '(min-width: 900px) 52vw, 100vw',
        preload: forloop.first,
        loading: 'lazy'
      %}
    {%- endfor -%}
  </div>

  <div class="buy-box__info">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .buy-box {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
    padding-block: var(--space-xl);
  }

  .buy-box__info {
    display: grid;
    gap: var(--space-s);
  }

  @media (min-width: 900px) {
    .buy-box {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "blocks": [
    { "type": "_product-title" },
    { "type": "_product-price" },
    { "type": "_product-description" },
    { "type": "_variant-picker" },
    { "type": "_buy-buttons" }
  ],
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
