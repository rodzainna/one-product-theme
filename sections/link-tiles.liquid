{% comment %}
  Two to four photo tiles that fill the screen: the first is tall, the rest stack beside it.
  https://shopify.dev/docs/storefronts/themes/architecture/blocks/theme-blocks
{% endcomment %}

{%- liquid
  assign count = section.blocks.size
  assign rows = count | minus: 1 | at_least: 1
-%}
{%- if count == 0 -%}
  <div data-empty></div>
{%- else -%}
  <div
    class="link-tiles full-width section-full color-{{ section.settings.color_scheme }}"
    style="--tiles-gradient: {{ section.settings.gradient }}%; --tiles-rows: {{ rows }};"
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="visually-hidden">{{ section.settings.heading | escape }}</h2>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'link_tiles.heading' | t }}</h2>
    {%- endif -%}
    <div class="link-tiles__grid" data-count="{{ count }}">
      {% content_for 'blocks' %}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .link-tiles {
    display: flex;
    flex-direction: column;
  }
  .link-tiles__grid {
    display: grid;
    flex: 1;
    gap: 2px;
  }
  .link-tiles__grid > .shopify-block {
    display: flex;
    min-width: 0;
  }
  @media (min-width: 900px) {
    .link-tiles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: minmax(0, 1fr);
    }
    .link-tiles__grid[data-count='1'] {
      grid-template-columns: minmax(0, 1fr);
    }
    .link-tiles__grid > .shopify-block:first-child {
      grid-row: span var(--tiles-rows);
    }
    .link-tiles .tile {
      min-height: 0;
    }
    /* The sticky add-to-cart bar covers the bottom of the tiles on this layout. */
    .link-tiles__grid > .shopify-block:is(:first-child, :last-child) .tile__text {
      --tile-clearance: calc(var(--space-l) + var(--sticky-bar-h));
      padding-block-end: var(--tile-clearance);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.link_tiles",
  "blocks": [{ "type": "_tile" }],
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "gradient",
      "label": "t:labels.gradient",
      "info": "t:info.gradient",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.hidden_heading",
      "default": "Explore"
    }
  ],
  "presets": [
    {
      "name": "t:general.link_tiles",
      "blocks": [
        { "type": "_tile", "settings": { "title": "First tile" } },
        { "type": "_tile", "settings": { "title": "Second tile" } },
        { "type": "_tile", "settings": { "title": "Third tile" } }
      ]
    }
  ]
}
{% endschema %}
