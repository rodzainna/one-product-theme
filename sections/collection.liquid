{% comment %}
  The collection page: its title and description, a grid of product cards and page links.
  Also serves /collections/all.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{%- paginate collection.products by 12 -%}
  <div class="collection">
    <header class="collection__header">
      <h1 class="collection__title h2">{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection__description">
          {% render 'rte', content: collection.description %}
        </div>
      {%- endif -%}
    </header>

    {%- liquid
      assign active_count = 0
      for filter in collection.filters
        if filter.type == 'price_range'
          if filter.min_value.value != blank or filter.max_value.value != blank
            assign active_count = active_count | plus: 1
          endif
        else
          assign active_count = active_count | plus: filter.active_values.size
        endif
      endfor

      assign clear_url = collection.url
      if collection.sort_by != blank
        assign sort_param = collection.sort_by | url_encode
        assign clear_url = collection.url | append: '?sort_by=' | append: sort_param
      endif
    -%}

    {%- if collection.products_count > 0 or active_count > 0 -%}
      {% render 'collection-filters', active_count: active_count, clear_url: clear_url %}
    {%- endif -%}

    {%- if collection.products.size == 0 -%}
      <div class="collection__empty">
        {%- if collection.products_count > 0 -%}
          <p>{{ 'collection.past_end' | t }}</p>
          {%- assign first_label = 'collection.first_page' | t -%}
          {%- assign first_url = paginate.parts[0].url | default: clear_url -%}
          {% render 'button', label: first_label, url: first_url, variant: 'secondary' %}
        {%- elsif active_count > 0 -%}
          <p>{{ 'collection.no_matches' | t }}</p>
          {%- assign clear_label = 'collection.clear_all' | t -%}
          {% render 'button', label: clear_label, url: clear_url, variant: 'secondary' %}
        {%- else -%}
          <p>{{ 'collection.empty' | t }}</p>
          {%- if collection.handle != 'all' -%}
            {%- assign browse_label = 'collection.browse_all' | t -%}
            {% render 'button', label: browse_label, url: routes.all_products_collection_url, variant: 'secondary' %}
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- else -%}
      <ul class="collection__grid">
        {%- for product in collection.products -%}
          {%- liquid
            assign card_loading = 'lazy'
            if forloop.index <= 4
              assign card_loading = 'eager'
            endif
          -%}
          <li>
            {% render 'product-card',
              product: product,
              heading_tag: 'h2',
              sizes: '(min-width: 900px) 22vw, (min-width: 600px) 30vw, 44vw',
              loading: card_loading
            %}
          </li>
        {%- endfor -%}
      </ul>

      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% stylesheet %}
  .collection {
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-l) var(--space-xl);
  }

  .collection__header {
    display: grid;
    gap: var(--space-s);
  }

  .collection__title {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .collection__empty {
    display: grid;
    gap: var(--space-s);
    justify-items: start;
  }

  .collection__empty p {
    margin: 0;
  }

  .collection__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection__grid > li {
    display: grid;
  }

  @media (min-width: 600px) {
    .collection__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-m);
    }
  }

  @media (min-width: 900px) {
    .collection__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
