{% comment %}
  A wall of review cards in uneven columns, each opening its full review in a dialog. App blocks
  from a reviews app sit in the grid as full-width rows.
  https://shopify.dev/docs/storefronts/themes/architecture/blocks/theme-blocks
{% endcomment %}

{%- if section.blocks.size == 0 -%}
  <div data-empty></div>
{%- else -%}
  <div class="review-wall full-width color-{{ section.settings.color_scheme }}">
    <div class="review-wall__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="review-wall__heading">{{ section.settings.heading | escape }}</h2>
      {%- else -%}
        <h2 class="review-wall__heading visually-hidden">{{ 'reviews.heading' | t }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="review-wall__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <review-wall class="review-wall__grid">
        {% content_for 'blocks' %}
      </review-wall>
    </div>
  </div>
  <script src="{{ 'review-wall.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  .review-wall {
    display: grid;
    grid-template-columns: var(--content-grid);
    width: 100%;
  }
  .review-wall__content {
    --review-wall-clearance: calc(var(--space-xl) + var(--sticky-bar-h, 0px));

    grid-column: 2;
    padding-block: var(--space-xl) var(--review-wall-clearance);
    /* Clears the section dots on narrow screens. */
    padding-inline-end: var(--space-m);
  }
  .review-wall__heading,
  .review-wall__text {
    margin: 0;
  }
  .review-wall__text {
    margin-top: var(--space-xs);
    color: var(--color-foreground-muted);
    font-size: var(--text-small);
  }
  .review-wall__grid {
    --review-row: 8px;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--space-m);
    align-items: start;
    margin-top: var(--space-l);
  }
  /* Each item's margin is the gap below it; review-wall.js sets the rows it spans. */
  .review-wall__grid > * {
    margin-bottom: var(--space-m);
  }
  .review-wall__grid[data-masonry] {
    grid-auto-rows: var(--review-row);
    grid-auto-flow: row dense;
  }
  .review-wall__grid[data-masonry] > * {
    grid-row: span var(--review-span, 1);
  }
  /* A block that rendered nothing leaves an empty wrapper; it takes no place in the grid. */
  .review-wall__grid > :not(:has(*)) {
    display: none;
  }
  /* Anything that isn't a review, such as an app block, takes a full row. */
  .review-wall__grid > :not(:has(> .review, > .review-empty)) {
    grid-column: 1 / -1;
  }
  @media (min-width: 700px) {
    .review-wall__content {
      padding-inline-end: 0;
    }
    .review-wall__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .review-wall__grid > :has(> .review--wide) {
      grid-column: span 2;
    }
  }
  @media (min-width: 1100px) {
    .review-wall__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.review_wall",
  "blocks": [{ "type": "_review" }, { "type": "@app" }],
  "max_blocks": 24,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "What people are saying"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.help_text"
    }
  ],
  "presets": [
    {
      "name": "t:general.review_wall",
      "blocks": [{ "type": "_review" }, { "type": "_review" }, { "type": "_review" }]
    }
  ]
}
{% endschema %}
