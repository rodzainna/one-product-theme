<div class="custom-section full-width color-{{ section.settings.color_scheme }}{% if section.settings.full_screen %} section-full{% endif %}">
  {% if section.settings.background_image %}
    {%- liquid
      assign preload_background = false
      if section.index == 1
        assign preload_background = true
      endif
    -%}
    <div class="custom-section__background">
      {% render 'image',
        image: section.settings.background_image,
        alt: '',
        class: 'custom-section__image',
        preload: preload_background
      %}
    </div>
  {% endif %}

  <div class="custom-section__content">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .custom-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
  }
  .custom-section__background {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .custom-section__image,
  .custom-section__background .image > img {
    height: 100%;
    object-fit: cover;
  }
  .custom-section__content {
    position: relative;
    display: grid;
    grid-template-columns: var(--content-grid);
  }
  .custom-section__content > * {
    grid-column: 2;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_section",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "checkbox",
      "id": "full_screen",
      "label": "t:labels.full_screen",
      "info": "t:info.full_screen",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:general.custom_section"
    }
  ]
}
{% endschema %}
