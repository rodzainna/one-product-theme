{%- liquid
  assign parallax = false
  if section.settings.parallax and section.settings.full_screen and section.settings.background_image
    assign parallax = true
  endif

  assign is_empty = false
  if section.blocks.size == 0 and section.settings.full_screen == false
    assign is_empty = true
  endif
-%}
<div
  class="custom-section full-width color-{{ section.settings.color_scheme }}{% if section.settings.full_screen %} section-full{% endif %}{% if parallax %} parallax{% endif %}"
  {% if is_empty %}
    data-empty
  {% endif %}
>
  {% if section.settings.background_image and is_empty == false %}
    {%- liquid
      assign preload_background = false
      if section.index == 1
        assign preload_background = true
      endif
    -%}
    <div
      class="custom-section__background{% if parallax %} parallax__media{% endif %}"
      style="--custom-section-overlay: {{ section.settings.overlay }}%;"
    >
      {% render 'image',
        image: section.settings.background_image,
        alt: '',
        class: 'custom-section__image',
        preload: preload_background
      %}
    </div>
  {% endif %}

  <div class="custom-section__content">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .custom-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    width: 100%;
  }
  .custom-section__background {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .custom-section__background::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-background) var(--custom-section-overlay), transparent);
  }
  .custom-section__image,
  .custom-section__background .image > img {
    height: 100%;
    object-fit: cover;
  }
  .custom-section__content {
    position: relative;
    display: grid;
    grid-template-columns: var(--content-grid);
  }
  .custom-section__content > * {
    grid-column: 2;
  }
  /* A full-screen section centres its content, clear of the sticky bar. */
  .custom-section.section-full {
    display: grid;
    align-content: center;
  }
  .custom-section.section-full .custom-section__content {
    --custom-section-clearance: calc(var(--space-2xl) + var(--sticky-bar-h, 0px));
    --custom-section-copy-max: 45rem;
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: var(--space-m) var(--space-s);
    width: min(var(--custom-section-copy-max), var(--content-width));
    margin-inline: auto;
    padding-block: var(--space-2xl) var(--custom-section-clearance);
  }
  .custom-section.section-full .custom-section__content > * {
    flex: 1 0 100%;
  }
  /* Buttons share a row and follow the text alignment. */
  .custom-section.section-full .custom-section__content > :has(.button-block) {
    flex: 0 0 auto;
  }
  .custom-section.section-full .custom-section__content:has([data-align='center']) {
    justify-content: center;
  }
  .custom-section.section-full .custom-section__content:has([data-align='right']) {
    justify-content: flex-end;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_section",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background_image"
    },
    {
      "type": "checkbox",
      "id": "full_screen",
      "label": "t:labels.full_screen",
      "info": "t:info.full_screen",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "t:labels.overlay",
      "info": "t:info.overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "t:labels.parallax",
      "info": "t:info.parallax",
      "default": false,
      "visible_if": "{{ section.settings.full_screen and section.settings.background_image != blank }}"
    }
  ],
  "presets": [
    {
      "name": "t:general.custom_section"
    }
  ]
}
{% endschema %}
