{% comment %}
  A full-screen comparison table: your product beside up to three others, one row per block.
  https://shopify.dev/docs/storefronts/themes/architecture/blocks/theme-blocks
{% endcomment %}

{%- if section.blocks.size == 0 -%}
  <div data-empty></div>
{%- else -%}
  {%- liquid
    assign others = 0
    for column in (2..4)
      assign column_key = 'column_' | append: column
      if section.settings[column_key] != blank
        assign others = others | plus: 1
      endif
    endfor
    assign column_count = others | plus: 1

    # Three or more columns scroll sideways on narrow screens rather than squash.
    assign wide = ''
    if column_count > 2
      assign wide = ' compare--wide'
    endif

    assign heading_id = 'compare-' | append: section.id | append: '-heading'
    assign first_name = section.settings.column_1
    if first_name == blank
      assign first_name = 'compare.ours' | t
    endif
    assign heading = section.settings.heading
    if heading == blank
      assign heading = 'compare.heading' | t
    endif
    assign has_link = false
    if section.settings.link != blank and section.settings.link_label != blank
      assign has_link = true
    endif
  -%}
  <div
    class="compare full-width section-full color-{{ section.settings.color_scheme }}{{ wide }}"
    style="--compare-columns: {{ column_count }};"
  >
    <div class="compare__content">
      <h2 class="compare__heading" id="{{ heading_id }}">{{ heading | escape }}</h2>
      <compare-table class="compare__wrap">
        {%- if others > 1 -%}
          <div
            class="compare__switch"
            role="group"
            aria-label="{{ 'compare.compare_with' | t: name: first_name }}"
            hidden
          >
            {%- for column in (2..4) -%}
              {%- assign column_key = 'column_' | append: column -%}
              {%- if section.settings[column_key] != blank -%}
                <button type="button" aria-pressed="false" data-option="{{ column }}">
                  {{- section.settings[column_key] | escape -}}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="compare__scroll" role="region" aria-labelledby="{{ heading_id }}" tabindex="0">
          <div class="compare__table" role="table" aria-labelledby="{{ heading_id }}">
            <div role="rowgroup">
              <div class="compare__row compare__row--head" role="row">
                <div class="compare__cell" role="columnheader">
                  <span class="visually-hidden">{{ 'compare.feature' | t }}</span>
                </div>
                {%- for column in (1..4) -%}
                  {%- assign column_key = 'column_' | append: column -%}
                  {%- assign column_name = section.settings[column_key] -%}
                  {%- if column == 1 or column_name != blank -%}
                    <div class="compare__cell" role="columnheader" data-column="{{ column }}">
                      {%- if column == 1 -%}
                        {{- first_name | escape -}}
                      {%- else -%}
                        {{- column_name | escape -}}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
            <div class="compare__body" role="rowgroup">
              {% content_for 'blocks' %}
            </div>
          </div>
        </div>
      </compare-table>
      {%- if section.settings.note != blank or has_link -%}
        <p class="compare__help">
          {%- if section.settings.note != blank -%}
            {{ section.settings.note | escape }}
          {%- endif -%}
          {%- if has_link -%}
            <a class="compare__link" href="{{ section.settings.link | escape }}">
              {{- section.settings.link_label | escape -}}
            </a>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  </div>
  {%- if others > 1 -%}
    <script src="{{ 'compare-table.js' | asset_url }}" type="module"></script>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .compare {
    display: grid;
    grid-template-columns: var(--content-grid);
    align-items: center;
    width: 100%;
  }
  .compare__content {
    --compare-clearance: calc(var(--space-xl) + var(--sticky-bar-h, 0px));

    grid-column: 2;
    min-width: 0;
    padding-block: var(--space-xl) var(--compare-clearance);
    /* Clears the section dots on narrow screens. */
    padding-inline-end: var(--space-m);
  }
  .compare__heading,
  .compare__help {
    margin: 0;
  }
  .compare__wrap {
    display: block;
    margin-block: var(--space-l);
  }
  .compare__scroll {
    overflow-x: auto;
  }
  .compare--wide .compare__table {
    min-width: calc(8rem + var(--compare-columns) * 9rem);
  }
  .compare__row {
    display: grid;
    grid-template-columns: minmax(8rem, 1.1fr) repeat(var(--compare-columns), minmax(0, 1fr));
    border-bottom: 1px solid var(--color-border);
  }
  .compare__row--head {
    border-bottom-color: var(--color-control-border);
    font-family: var(--font-heading);
  }
  .compare__cell {
    padding: var(--space-s);
    overflow-wrap: break-word;
  }
  .compare__cell--label {
    font-weight: var(--weight-ui);
  }
  /* Your own column is tinted and bold. */
  .compare__cell[data-column='1'] {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    font-weight: var(--weight-ui);
  }
  .compare__mark {
    display: inline-flex;
    margin-inline-end: var(--space-2xs);
    vertical-align: middle;
  }
  .compare__mark--yes {
    color: var(--color-success);
  }
  .compare__mark--no {
    color: var(--color-error);
  }
  /* A block that rendered nothing leaves an empty wrapper. */
  .compare__body > :not(:has(*)) {
    display: none;
  }
  .compare__switch {
    display: none;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: var(--space-xs);
    margin-bottom: var(--space-m);
  }
  .compare__switch button {
    min-height: var(--control-h);
    padding: var(--control-pad-xs);
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-button);
    background: none;
    color: var(--color-foreground);
    font-family: inherit;
    font-weight: var(--weight-ui);
    cursor: pointer;
  }
  .compare__switch button[aria-pressed='true'] {
    border-color: var(--color-foreground);
    background: var(--color-foreground);
    color: var(--color-background);
  }
  .compare__help {
    color: var(--color-foreground-muted);
    font-size: var(--text-small);
  }
  .compare__link {
    display: block;
    width: fit-content;
    min-height: var(--target-min);
    color: var(--color-foreground);
    font-weight: var(--weight-ui);
  }
  @media (max-width: 699px) {
    .compare__switch:not([hidden]) {
      display: grid;
    }
    /* With the switch on, only your column and the chosen one show. */
    .compare compare-table[data-showing] .compare__table {
      min-width: 0;
    }
    compare-table[data-showing] .compare__row {
      grid-template-columns: minmax(5rem, 1fr) repeat(2, minmax(0, 1.2fr));
    }
    compare-table[data-showing='2'] :is([data-column='3'], [data-column='4']),
    compare-table[data-showing='3'] :is([data-column='2'], [data-column='4']),
    compare-table[data-showing='4'] :is([data-column='2'], [data-column='3']) {
      display: none;
    }
  }
  @media (min-width: 700px) {
    .compare__content {
      padding-inline-end: 0;
    }
    .compare .compare__table {
      min-width: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.compare_table",
  "blocks": [{ "type": "_compare-row" }],
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "How we compare"
    },
    {
      "type": "text",
      "id": "note",
      "label": "t:labels.help_text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "header",
      "content": "t:labels.columns"
    },
    {
      "type": "text",
      "id": "column_1",
      "label": "t:labels.column_1",
      "info": "t:info.column_1",
      "default": "Our product"
    },
    {
      "type": "text",
      "id": "column_2",
      "label": "t:labels.column_2",
      "info": "t:info.column_other",
      "default": "Typical alternative"
    },
    {
      "type": "text",
      "id": "column_3",
      "label": "t:labels.column_3",
      "info": "t:info.column_other"
    },
    {
      "type": "text",
      "id": "column_4",
      "label": "t:labels.column_4",
      "info": "t:info.column_other"
    }
  ],
  "presets": [
    {
      "name": "t:general.compare_table",
      "blocks": [{ "type": "_compare-row" }, { "type": "_compare-row" }, { "type": "_compare-row" }]
    }
  ]
}
{% endschema %}
