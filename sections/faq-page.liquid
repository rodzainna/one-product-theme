{% comment %}
  The FAQ page: a header, every category with its questions on one page, a category list that
  follows the reader, and a closing block. The links come from the data-faq-cat attribute each
  category block writes into its own output, because a section can't read its theme blocks' settings.
  https://shopify.dev/docs/storefronts/themes/architecture/blocks/theme-blocks
{% endcomment %}

{%- capture groups_html -%}
  {% content_for 'blocks' %}
{%- endcapture -%}
{%- liquid
  assign markers = groups_html | split: 'data-faq-cat="'
  assign heading = section.settings.heading | default: page.title
  assign has_nav = false
  if markers.size > 2
    assign has_nav = true
  endif
  assign has_button = false
  if section.settings.closing_label != blank and section.settings.closing_link != blank
    assign has_button = true
  endif
-%}
<div class="faq-page full-width color-{{ section.settings.color_scheme }}">
  <div class="faq-page__inner">
    <div class="faq-page__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="faq-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="faq-page__heading">{{ heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="faq-page__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="faq-page__layout{% if has_nav %} faq-page__layout--nav{% endif %}">
      {%- if has_nav -%}
        <faq-nav class="faq-nav">
          <nav aria-label="{{ 'faq.categories' | t }}">
            <ul>
              {%- for part in markers offset: 1 -%}
                {%- assign marker = part | split: '"' | first -%}
                {%- assign bits = marker | split: '|||' -%}
                {%- assign title = marker | remove_first: bits[0] | remove_first: '|||' -%}
                <li>
                  <a href="#faq-{{ bits[0] }}">{{ title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        </faq-nav>
      {%- endif -%}

      <div class="faq-page__groups">
        {{ groups_html }}

        {%- if section.settings.closing_heading != blank -%}
          <div class="faq-page__end">
            <h2 class="faq-page__end-heading">{{ section.settings.closing_heading | escape }}</h2>
            {%- if section.settings.closing_text != blank -%}
              <p class="faq-page__end-text">{{ section.settings.closing_text | escape }}</p>
            {%- endif -%}
            {%- if has_button -%}
              {% render 'button', label: section.settings.closing_label, url: section.settings.closing_link %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'faq-nav.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .faq-page {
    display: grid;
    grid-template-columns: var(--content-grid);
    width: 100%;
  }
  .faq-page__inner {
    grid-column: 2;
    padding-block: var(--space-xl) var(--space-2xl);
  }
  .faq-page__head {
    max-width: 40rem;
    margin-bottom: var(--space-xl);
  }
  .faq-page__eyebrow {
    margin: 0 0 var(--space-xs);
    font-size: var(--text-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .faq-page__heading,
  .faq-page__text {
    margin: 0;
  }
  .faq-page__text {
    margin-top: var(--space-s);
    color: var(--color-foreground-muted);
  }
  .faq-nav {
    display: block;
  }
  .faq-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .faq-nav a {
    display: flex;
    align-items: center;
    min-height: var(--control-h);
    color: var(--color-foreground-muted);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }
  .faq-nav a:hover,
  .faq-nav a[aria-current] {
    color: var(--color-foreground);
  }
  .faq-nav a[aria-current] {
    font-weight: var(--weight-ui);
  }
  .faq-group {
    margin-bottom: var(--space-xl);
  }
  .faq-page__end-heading {
    margin: 0 0 var(--space-xs);
    font-size: var(--text-h3);
  }
  .faq-page__end-text {
    margin: 0 0 var(--space-m);
    color: var(--color-foreground-muted);
  }

  /* Phones: the categories are a sticky row of pills at the top of the screen. */
  @media (max-width: 899px) {
    .faq-nav {
      --faq-gutter: var(--page-gutter, var(--page-margin));
      position: sticky;
      top: 0;
      z-index: var(--layer-sticky);
      margin-inline: calc(var(--faq-gutter) * -1);
      margin-bottom: var(--space-l);
      padding-block: var(--space-xs);
      padding-inline: var(--faq-gutter);
      overflow-x: auto;
      background: var(--color-background);
      border-bottom: 1px solid var(--color-border);
      scrollbar-width: none;
    }
    .faq-nav ul {
      display: flex;
      gap: var(--space-xs);
      width: max-content;
    }
    .faq-nav a {
      padding-inline: var(--space-s);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-full);
      white-space: nowrap;
    }
    .faq-nav a[aria-current] {
      color: var(--color-background);
      background: var(--color-foreground);
      border-color: var(--color-foreground);
    }
    .faq-group {
      scroll-margin-top: calc(var(--control-h) + var(--space-xs) * 2 + var(--space-s));
    }
  }

  @media (min-width: 900px) {
    .faq-page__layout--nav {
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      column-gap: var(--space-xl);
    }
    .faq-nav {
      position: sticky;
      top: var(--space-l);
      align-self: start;
    }
    .faq-nav a {
      padding-left: var(--space-s);
      border-left: 2px solid var(--color-border);
    }
    .faq-nav a[aria-current] {
      border-left-color: var(--color-foreground);
    }
    .faq-group {
      scroll-margin-top: var(--space-l);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.faq_page",
  "blocks": [{ "type": "_faq-category" }],
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:info.page_title_heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text"
    },
    {
      "type": "header",
      "content": "t:labels.closing"
    },
    {
      "type": "text",
      "id": "closing_heading",
      "label": "t:labels.heading",
      "default": "Still have a question?"
    },
    {
      "type": "text",
      "id": "closing_text",
      "label": "t:labels.text"
    },
    {
      "type": "text",
      "id": "closing_label",
      "label": "t:labels.button_label",
      "default": "Get in touch"
    },
    {
      "type": "url",
      "id": "closing_link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.faq_page",
      "blocks": [
        { "type": "_faq-category", "settings": { "title": "First category" } },
        { "type": "_faq-category", "settings": { "title": "Second category" } }
      ]
    }
  ]
}
{% endschema %}
