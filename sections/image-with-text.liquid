{% comment %}
  A full-screen image beside a short text, with an optional button. Add several and flip the side to alternate.
  https://shopify.dev/docs/storefronts/themes/architecture/sections/section-schema
{% endcomment %}

{%- liquid
  assign image = section.settings.image
  assign has_button = false
  if section.settings.button_label != blank and section.settings.button_link != blank
    assign has_button = true
  endif
  assign has_copy = false
  if section.settings.heading != blank or section.settings.text != blank or section.settings.eyebrow != blank or has_button
    assign has_copy = true
  endif
  assign preload = false
  if section.index == 1
    assign preload = true
  endif
  assign parallax = false
  if section.settings.parallax and image != blank
    assign parallax = true
  endif
-%}
{%- if image == blank and has_copy == false -%}
  <div data-empty></div>
{%- else -%}
  <div
    class="image-text full-width section-full color-{{ section.settings.color_scheme }}{% if section.settings.image_right %} image-text--reverse{% endif %}"
  >
    <div class="image-text__grid{% if image == blank or has_copy == false %} image-text__grid--single{% endif %}">
      {%- if image != blank -%}
        <div class="image-text__frame{% if parallax %} parallax{% endif %}">
          <div class="image-text__media{% if parallax %} parallax__media{% endif %}">
            {% render 'image', image: image, sizes: '(min-width: 900px) 50vw, 100vw', preload: preload %}
          </div>
        </div>
      {%- endif -%}
      {%- if has_copy -%}
        <div class="image-text__copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="image-text__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="image-text__heading">{{ section.settings.heading | escape }}</h2>
          {%- else -%}
            <h2 class="visually-hidden">{{ 'image_with_text.heading' | t }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="image-text__text rte">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- if has_button -%}
            {% render 'button', label: section.settings.button_label, url: section.settings.button_link %}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .image-text {
    display: grid;
    grid-template-columns: var(--content-grid);
    align-items: center;
    width: 100%;
  }
  .image-text__grid {
    grid-column: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: center;
    --image-text-clearance: calc(var(--space-xl) + var(--sticky-bar-h, 0px));
    padding-block: var(--space-xl) var(--image-text-clearance);
  }
  .image-text__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
  }
  .image-text__media {
    position: absolute;
    inset: 0;
  }
  .image-text__media .image,
  .image-text .image-text__media .image > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .image-text__copy {
    display: grid;
    justify-items: start;
    gap: var(--space-m);
  }
  .image-text__copy > * {
    margin: 0;
  }
  .image-text__eyebrow {
    font-size: var(--text-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .image-text__text {
    max-width: 42ch;
    font-size: var(--text-lg);
  }
  @media (min-width: 900px) {
    .image-text__grid:not(.image-text__grid--single) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* Sized from the screen height, so the section fits one screen. */
    .image-text__frame {
      aspect-ratio: auto;
      height: min(calc(100svh - var(--header-group-h, 0px) - var(--sticky-bar-h, 0px) - var(--space-xl) * 2), 45rem);
    }
    .image-text--reverse .image-text__frame {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image_with_text",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "checkbox",
      "id": "image_right",
      "label": "t:labels.image_right",
      "info": "t:info.image_right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "t:labels.parallax",
      "info": "t:info.image_parallax",
      "default": true,
      "visible_if": "{{ section.settings.image != blank }}"
    },
    {
      "type": "header",
      "content": "t:labels.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Tell your story"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Pair a photo with a few lines about your product, how it is made or why it matters.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.image_with_text"
    }
  ]
}
{% endschema %}
