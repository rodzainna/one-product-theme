{% comment %}
  The page shown while the store is password protected: the logo or store name, the store's message
  and the password field, centred in the screen, with a link for the store owner to log in.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{%- liquid
  assign message = shop.password_message
  if message == blank
    assign message = 'password.default_message' | t
  endif
  assign password_id = 'Password-' | append: section.id
  assign password_label = 'password.password' | t
  assign enter_label = 'password.enter' | t
-%}

<div class="password section-full">
  <div class="password__card">
    {%- if section.settings.logo != blank -%}
      {%- assign logo_file_width = section.settings.logo_width | times: 3 -%}
      {%- assign logo_sizes = section.settings.logo_width | append: 'px' -%}
      <h1 class="visually-hidden">{{ shop.name | escape }}</h1>
      <div class="password__logo" style="--logo-width: {{ section.settings.logo_width }}px">
        {%- render 'image',
          image: section.settings.logo,
          alt: '',
          width: logo_file_width,
          sizes: logo_sizes,
          loading: 'eager'
        -%}
      </div>
    {%- else -%}
      <h1 class="password__name">{{ shop.name | escape }}</h1>
    {%- endif -%}

    <p class="password__message">{{ message | escape }}</p>

    {%- form 'storefront_password', class: 'password__form' -%}
      {% render 'input',
        id: password_id,
        label: password_label,
        label_hidden: true,
        type: 'password',
        name: 'password',
        placeholder: password_label,
        autocomplete: 'current-password',
        required: true,
        errors: form.errors,
        field: 'form'
      %}
      {% render 'button', label: enter_label, type: 'submit' %}
    {%- endform -%}

    <p class="password__owner">
      {{ 'password.owner' | t }}
      <a class="password__login" href="/admin">{{ 'password.owner_login' | t }}</a>
    </p>
  </div>
</div>

{% stylesheet %}
  .password {
    display: grid;
    align-content: center;
    justify-items: center;
    padding: var(--space-xl) var(--page-margin);
    text-align: center;
  }

  .password__card {
    display: grid;
    gap: var(--space-m);
    justify-items: center;
    inline-size: 100%;
    max-inline-size: 28rem;
  }

  .password__name {
    margin: 0;
    font-size: var(--text-h2);
    overflow-wrap: anywhere;
  }

  .password__logo {
    display: block;
    inline-size: var(--logo-width);
    max-inline-size: 100%;
  }

  .password__message {
    margin: 0;
    color: var(--color-foreground-muted);
    overflow-wrap: anywhere;
  }

  .password__form {
    display: flex;
    gap: var(--space-s);
    align-items: flex-start;
    inline-size: 100%;
    text-align: start;
  }

  .password__form .field {
    flex: 1;
    min-inline-size: 0;
  }

  .password__owner {
    margin: var(--space-s) 0 0;
    font-size: var(--text-small);
  }

  .password__login {
    color: var(--color-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.logo",
      "info": "t:info.logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 40,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "t:labels.logo_width",
      "default": 120,
      "visible_if": "{{ section.settings.logo != blank }}"
    }
  ]
}
{% endschema %}
