{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<h1>{{ 'password.title' | t }}</h1>

{% if shop.password_message %}
  <p>{{ shop.password_message }}</p>
{% endif %}

{% form 'storefront_password' %}
  {%- liquid
    assign password_id = 'Password-' | append: section.id
    assign password_label = 'password.password' | t
    assign enter_label = 'password.enter' | t
  -%}

  {% render 'input',
    id: password_id,
    label: password_label,
    type: 'password',
    name: 'password',
    autocomplete: 'current-password',
    required: true,
    errors: form.errors,
    field: 'form'
  %}
  {% render 'button', label: enter_label, type: 'submit' %}
{% endform %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
