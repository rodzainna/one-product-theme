{% doc %}
  Renders a collection as a card: square image (or a placeholder), title and product count.
  The title is the card's one link, stretched over the whole card, so the image isn't a second
  link to the same page.

  @param {collection} collection - The collection
  @param {string} sizes - The image's sizes attribute, from the grid's real columns
  @param {string} [loading] - eager for cards in the first screen, default lazy

  @example
  {% render 'collection-card', collection: collection, sizes: '(min-width: 900px) 22vw, 44vw' %}
{% enddoc %}

{%- liquid
  assign card_loading = loading | default: 'lazy'
  assign count_label = 'collection.products_count' | t: count: collection.products_count
-%}

<article class="collection-card">
  <div class="collection-card__media">
    {%- if collection.featured_image -%}
      {% render 'image',
        image: collection.featured_image,
        alt: '',
        sizes: sizes,
        aspect_ratio: '1',
        loading: card_loading
      %}
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
    {%- endif -%}
  </div>
  <div class="collection-card__body">
    <h2 class="collection-card__title">
      <a class="collection-card__link" href="{{ collection.url }}">{{ collection.title | escape }}</a>
    </h2>
    <p class="collection-card__count">{{ count_label }}</p>
  </div>
</article>

{% stylesheet %}
  .collection-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-background);
  }

  .collection-card__media {
    aspect-ratio: 1;
    background: var(--color-hover);
  }

  .collection-card__placeholder {
    width: 100%;
    height: 100%;
    fill: var(--color-foreground-muted);
  }

  .collection-card__body {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    padding: var(--space-s);
  }

  .collection-card__title {
    margin: 0;
    font-size: var(--text-body);
    line-height: var(--leading-snug);
  }

  .collection-card__count {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: var(--text-small);
  }

  .collection-card__link {
    color: inherit;
    text-decoration: none;
  }

  /* The one link covers the card, so the whole card is clickable. */
  .collection-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .collection-card__link:focus-visible {
    outline: none;
  }

  .collection-card:has(.collection-card__link:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  @media (hover: hover) {
    .collection-card:hover .collection-card__link {
      text-decoration: underline;
    }
  }
{% endstylesheet %}
