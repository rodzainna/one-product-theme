{% doc %}
  Renders the cart totals: order discounts, subtotal, the tax line, Check out and the
  accelerated checkout buttons. Check out submits the cart form through form=, so the
  quantities and note are saved on the way to checkout.

  @param {string} form_id - The cart form's id
  @param {boolean} [show_dynamic_checkout] - Shows the accelerated checkout buttons

  @example
  {% render 'cart-summary', form_id: form_id, show_dynamic_checkout: section.settings.show_dynamic_checkout %}
{% enddoc %}

{%- liquid
  assign checkout_label = 'cart.checkout' | t
  assign checkout_attributes = 'form="' | append: form_id | append: '"'
-%}

<div class="cart-summary">
  <dl class="cart-summary__totals">
    {%- for discount in cart.cart_level_discount_applications -%}
      <div class="cart-summary__row">
        <dt>{{ discount.title | escape }}</dt>
        <dd>−{{ discount.total_allocated_amount | money }}</dd>
      </div>
    {%- endfor -%}
    <div class="cart-summary__row cart-summary__row--main">
      <dt>{{ 'cart.subtotal' | t }}</dt>
      <dd>{{ cart.total_price | money_with_currency }}</dd>
    </div>
  </dl>

  <p class="cart-summary__tax">{% render 'tax-note', long: true %}</p>

  {% render 'button', label: checkout_label, type: 'submit', name: 'checkout', attributes: checkout_attributes %}

  {%- if additional_checkout_buttons and show_dynamic_checkout -%}
    <div class="cart-summary__accelerated">{{ content_for_additional_checkout_buttons }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-summary {
    display: grid;
    gap: var(--space-s);
  }

  .cart-summary .button {
    width: 100%;
  }

  .cart-summary__totals {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
  }

  .cart-summary__row {
    display: flex;
    gap: var(--space-s);
    justify-content: space-between;
  }

  .cart-summary__row dd {
    margin: 0;
  }

  .cart-summary__row--main {
    font-weight: var(--weight-ui);
  }

  .cart-summary__tax {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: var(--text-small);
  }
{% endstylesheet %}
