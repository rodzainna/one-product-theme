{% doc %}
  Renders an article as a card for the blog list: the featured image at 3:2 when it has one, the
  date and author, the title and a short excerpt. The title is the card's one link, stretched over
  the whole card, so the image isn't a second link to the same page.

  @param {object} article - The article
  @param {string} sizes - The image's sizes attribute, from the grid's real columns
  @param {string} [loading] - eager for the card that is the first thing on screen, default lazy

  @example
  {% render 'article-card', article: article, sizes: '(min-width: 900px) 30vw, 100vw' %}
{% enddoc %}

{%- liquid
  assign card_loading = loading | default: 'lazy'
  assign date = article.published_at | time_tag: format: 'date'
  # An _html key doesn't escape its values, so the author is escaped here.
  assign author = article.author | escape
  assign excerpt = article.excerpt_or_content | strip_html | newline_to_br | replace: '<br />', ' ' | truncatewords: 20
-%}

<article class="article-card linked-card">
  {%- if article.image != blank -%}
    <div class="article-card__media">
      {% render 'image', image: article.image, sizes: sizes, aspect_ratio: '3 / 2', loading: card_loading %}
    </div>
  {%- endif -%}
  <div class="article-card__body">
    <p class="article-card__meta">{{ 'blog.article_metadata_html' | t: date: date, author: author }}</p>
    <h2 class="article-card__title">
      <a class="linked-card__link" href="{{ article.url }}">{{ article.title | escape }}</a>
    </h2>
    {%- if excerpt != blank -%}
      <p class="article-card__excerpt">{{ excerpt | escape }}</p>
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  .article-card {
    display: flex;
    flex-direction: column;
  }

  .article-card__body {
    flex: 1;
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    padding: var(--space-m);
  }

  .article-card__meta,
  .article-card__excerpt {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .article-card__meta {
    color: var(--color-foreground-muted);
    font-size: var(--text-small);
  }

  .article-card__title {
    margin: 0;
    font-size: var(--text-h4);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }
{% endstylesheet %}
