{% doc %}
  Renders an article or a page found by a search as a card: the article's image when it has one,
  a type label, the title and a short excerpt. The title is the card's one link, stretched over
  the whole card. Products use the product card instead.

  @param {object} result - The article or page
  @param {string} sizes - The image's sizes attribute, from the grid's real columns
  @param {string} [loading] - eager for cards in the first screen, default lazy

  @example
  {% render 'search-result-card', result: result, sizes: '(min-width: 900px) 22vw, 44vw' %}
{% enddoc %}

{%- liquid
  assign card_loading = loading | default: 'lazy'
  if result.object_type == 'article'
    assign type_label = 'search.types.article' | t
    assign excerpt_source = result.excerpt_or_content
  else
    assign type_label = 'search.types.page' | t
    assign excerpt_source = result.content
  endif
  assign excerpt = excerpt_source | strip_html | newline_to_br | replace: '<br />', ' ' | truncatewords: 20
-%}

<article class="result-card linked-card">
  {%- if result.image != blank -%}
    <div class="result-card__media">
      {% render 'image', image: result.image, alt: '', sizes: sizes, aspect_ratio: '1', loading: card_loading %}
    </div>
  {%- endif -%}
  <div class="result-card__body">
    {% render 'badge', text: type_label %}
    <h2 class="result-card__title">
      <a class="linked-card__link" href="{{ result.url }}">{{ result.title | escape }}</a>
    </h2>
    {%- if excerpt != blank -%}
      <p class="result-card__excerpt">{{ excerpt | escape }}</p>
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  .result-card {
    display: flex;
    flex-direction: column;
  }

  .result-card__body {
    flex: 1;
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    justify-items: start;
    padding: var(--space-s);
  }

  .result-card__title {
    margin: 0;
    font-size: var(--text-body);
    line-height: var(--leading-snug);
    overflow-wrap: anywhere;
  }

  .result-card__excerpt {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: var(--text-small);
    overflow-wrap: anywhere;
  }
{% endstylesheet %}
