{% doc %}
  Renders a variant's price, with compare-at, sale or sold-out badge, and unit price.
  Given a selling plan allocation, it shows that plan's prices instead.
  <s> isn't announced by screen readers, so hidden "Sale price" and "Regular price" labels name each amount.

  @param {variant} variant - The variant to price
  @param {selling_plan_allocation} [allocation] - The selected selling plan allocation, if any
  @param {string} [size] - lg for the buy box, or blank for the default
  @param {product} [range_product] - For product cards: shows "From" the lowest price when the variants' prices differ (not `product`, which Liquid fills with the page's product)
  @param {string} [tax_info_id] - For the buy box: unique id for an ⓘ with the tax and shipping note, plus a visible line when the store's prices include tax or duties

  @example
  {% render 'price', variant: product.selected_or_first_available_variant, size: 'lg' %}
{% enddoc %}

{%- liquid
  assign source = allocation | default: variant
  assign on_sale = false
  if variant.available and source.compare_at_price > source.price
    assign on_sale = true
  endif
  # A range has no single variant, so its sale badge and unit price would belong to just one.
  assign price_range = false
  if range_product.price_varies
    assign price_range = true
    assign on_sale = false
  endif
-%}

<div class="price{% if size == 'lg' %} price--lg{% endif %}">
  {%- if price_range -%}
    {%- assign price_min = range_product.price_min | money | strip_html -%}
    <span>{{ 'products.product.price_from' | t: price: price_min }}</span>
  {%- elsif on_sale -%}
    <span class="visually-hidden">{{ 'products.product.sale_price' | t }}</span>
    <span>{{ source.price | money }}</span>
    <span class="visually-hidden">{{ 'products.product.regular_price' | t }}</span>
    <s class="price__compare">{{ source.compare_at_price | money }}</s>
  {%- else -%}
    <span>{{ source.price | money }}</span>
  {%- endif -%}

  {%- if variant.available == false -%}
    {%- assign sold_out_label = 'products.product.sold_out' | t -%}
    {%- render 'badge', text: sold_out_label -%}
  {%- elsif on_sale -%}
    {%- assign sale_label = 'products.product.on_sale' | t -%}
    {%- render 'badge', text: sale_label, variant: 'sale' -%}
  {%- endif -%}

  {%- if tax_info_id != blank -%}
    {%- liquid
      assign tax_label = 'products.product.tax_info_label' | t
    -%}
    {%- capture tax_line -%}{% render 'tax-note' %}{%- endcapture -%}
    {%- capture tax_text -%}{% render 'tax-note', long: true %}{%- endcapture -%}
    {%- assign tax_line = tax_line | strip -%}
    {%- assign tax_text = tax_text | strip -%}
    {%- render 'tooltip', id: tax_info_id, label: tax_label, text: tax_text -%}
  {%- endif -%}

  {%- if variant.unit_price_measurement and price_range == false -%}
    {% render 'unit-price',
      price: source.unit_price,
      measurement: variant.unit_price_measurement,
      class: 'price__note'
    %}
  {%- endif -%}

  {%- if tax_line != blank -%}
    <p class="price__note">{{ tax_line }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--control-pad-y) var(--control-pad-xs);
    font-weight: var(--weight-ui);
  }

  .price--lg {
    font-size: var(--text-h4);
  }

  .price__compare {
    color: var(--color-foreground-muted);
    font-weight: var(--weight-body);
  }

  .price--lg .price__compare {
    font-size: var(--text-body);
  }

  .price__note {
    flex-basis: 100%;
    color: var(--color-foreground-muted);
    font-size: var(--text-small);
    font-weight: var(--weight-body);
  }
{% endstylesheet %}
