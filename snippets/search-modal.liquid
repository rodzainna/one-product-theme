{% doc %}
  Renders the search modal: a modal <dialog> card with the search field and Close beside
  each other, and predictive results under them (assets/predictive-search.js).
  Any button or link with data-dialog-open="<id>" opens it, through assets/dialog.js. The results
  section answers to fixed ids, so render it once per page.

  @param {string} id - Unique id, used by the button that opens it

  @example
  {% render 'search-modal', id: 'SearchModal' %}
{% enddoc %}

{%- liquid
  assign field_id = id | append: '-field'
  assign search_label = 'header.search' | t
  assign clear_label = 'search.predictive.clear' | t
  assign close_label = 'accessibility.close' | t
-%}

<predictive-search data-url="{{ routes.predictive_search_url }}">
  <dialog class="dialog search-modal" id="{{ id }}" aria-label="{{ search_label }}" data-close-outside>
    <form class="search-modal__form" action="{{ routes.search_url }}" method="get" role="search">
      <div class="search-modal__bar">
        <div class="search-modal__field">
          {%- render 'icon', name: 'search' -%}
          <span class="search-modal__loader">{%- render 'icon', name: 'loader' -%}</span>
          <label class="visually-hidden" for="{{ field_id }}">{{ search_label }}</label>
          <input
            class="search-modal__input"
            id="{{ field_id }}"
            type="text"
            name="q"
            enterkeyhint="search"
            placeholder="{{ 'search.predictive.placeholder' | t }}"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            autofocus
            role="combobox"
            aria-autocomplete="list"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls="predictive-search-listbox"
            data-field
          >
          {%- render 'icon-button', icon: 'close', label: clear_label, size: 'sm', attributes: 'hidden data-clear' -%}
        </div>
        <button class="search-modal__close" type="button" data-dialog-close>{{ close_label }}</button>
      </div>
    </form>
    <div class="search-modal__results" data-results tabindex="0"></div>
    <p class="visually-hidden" role="status" data-status></p>
  </dialog>
</predictive-search>

<script src="{{ 'dialog.js' | asset_url }}" type="module"></script>
<script src="{{ 'predictive-search.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  /* A card below the header, in the upper part of the window, so it grows downward as results arrive instead of moving around. */
  .dialog.search-modal {
    width: min(100% - 2rem, 36rem);
    max-height: calc(100dvh - max(var(--space-xl), 15dvh) - var(--space-m));
    margin: max(var(--space-xl), 15dvh) auto auto;
  }

  .search-modal__bar {
    display: flex;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-m);
  }

  /* A soft filled field; focus shows as a dark border, not the page-wide ring around a field that's focused on open. */
  .search-modal__field {
    display: flex;
    flex: 1;
    gap: var(--space-xs);
    align-items: center;
    min-inline-size: 0;
    min-block-size: calc(var(--control-h) + var(--space-xs));
    padding-inline: var(--control-pad-m) var(--space-2xs);
    border: 2px solid transparent;
    border-radius: var(--radius-input);
    background: var(--color-hover);
    transition: border-color var(--duration) var(--ease);
  }

  /* While a search is pending the loader takes the search icon's place, at the same size, so nothing shifts. */
  .search-modal__loader {
    display: none;
  }

  predictive-search[data-loading] .search-modal__field > .icon {
    display: none;
  }

  predictive-search[data-loading] .search-modal__loader {
    display: inline-flex;
    animation: search-modal-spin var(--duration-spin) var(--ease-linear) infinite;
  }

  @keyframes search-modal-spin {
    to {
      rotate: 360deg;
    }
  }

  .search-modal__field:focus-within {
    border-color: var(--color-foreground);
  }

  .search-modal__input {
    flex: 1;
    min-inline-size: 0;
    min-block-size: var(--control-h);
    padding: var(--control-pad-y) 0;
    border: 0;
    background: transparent;
    color: var(--color-foreground);
    font-size: var(--text-lg);
  }

  .search-modal__input:focus {
    outline: 0;
  }

  .search-modal__input::placeholder {
    color: var(--color-foreground-muted);
    opacity: 1;
  }

  .search-modal__close {
    flex: none;
    min-block-size: var(--control-h);
    padding-inline: var(--space-xs);
    border: 0;
    border-radius: var(--radius-input);
    background: none;
    color: inherit;
    font-weight: var(--weight-ui);
    cursor: pointer;
  }

  @media (hover: hover) {
    .search-modal__close:hover {
      background: var(--color-hover);
    }
  }

  .search-modal__results {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 var(--space-m) var(--space-m);
  }

  /* It drops in a little and fades up; with reduced motion it just appears. */
  @media (prefers-reduced-motion: no-preference) {
    .dialog.search-modal[open],
    .dialog.search-modal[open]::backdrop {
      transition:
        translate var(--duration) var(--ease-settle),
        opacity var(--duration) var(--ease),
        background-color var(--duration) var(--ease);
    }

    @starting-style {
      .dialog.search-modal[open] {
        translate: 0 -0.5rem;
        opacity: 0;
      }

      .dialog.search-modal[open]::backdrop {
        background-color: transparent;
      }
    }
  }

  .search-modal__results:focus-visible {
    outline: var(--focus-ring);
    outline-offset: calc(-1 * var(--focus-offset));
  }

  /* Nothing under the field until there is something to show. */
  .search-modal__results:empty {
    display: none;
  }
{% endstylesheet %}
