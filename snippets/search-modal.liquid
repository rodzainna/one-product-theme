{% doc %}
  Renders the search modal: a modal <dialog> card with the search field and Close beside
  each other, and predictive results under them (assets/predictive-search.js).
  Any button or link with data-dialog-open="<id>" opens it, through assets/dialog.js. The results
  section answers to fixed ids, so render it once per page.

  @param {string} id - Unique id, used by the button that opens it

  @example
  {% render 'search-modal', id: 'SearchModal' %}
{% enddoc %}

{%- liquid
  assign field_id = id | append: '-field'
  assign search_label = 'header.search' | t
  assign clear_label = 'search.predictive.clear' | t
  assign close_label = 'accessibility.close' | t
  assign placeholder = 'search.predictive.placeholder' | t
-%}

<predictive-search data-url="{{ routes.predictive_search_url }}">
  <dialog class="dialog search-modal" id="{{ id }}" aria-label="{{ search_label }}" data-close-outside>
    <form class="search-modal__form" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="article,page,product">
      <div class="search-modal__bar">
        {%- capture field_attributes -%}
          aria-controls="predictive-search-listbox" aria-autocomplete="list" aria-haspopup="listbox"
          aria-expanded="false" role="combobox" autofocus
        {%- endcapture -%}
        {% render 'search-field',
          id: field_id,
          label: search_label,
          clear_label: clear_label,
          type: 'text',
          placeholder: placeholder,
          attributes: field_attributes
        %}
        <button class="search-modal__close" type="button" data-dialog-close>{{ close_label }}</button>
      </div>
    </form>
    <div class="search-modal__results" data-results tabindex="0"></div>
    <p class="visually-hidden" role="status" data-status></p>
  </dialog>
</predictive-search>

<script src="{{ 'dialog.js' | asset_url }}" type="module"></script>
<script src="{{ 'predictive-search.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  /* A card below the header, in the upper part of the window, so it grows downward as results arrive instead of moving around. */
  .dialog.search-modal {
    width: min(100% - 2rem, 36rem);
    max-height: calc(100dvh - max(var(--space-xl), 15dvh) - var(--space-m));
    margin: max(var(--space-xl), 15dvh) auto auto;
  }

  .search-modal__bar {
    display: flex;
    gap: var(--space-s);
    align-items: center;
    padding: var(--space-m);
  }

  .search-modal__close {
    flex: none;
    min-block-size: var(--control-h);
    padding-inline: var(--space-xs);
    border: 0;
    border-radius: var(--radius-input);
    background: none;
    color: inherit;
    font-weight: var(--weight-ui);
    cursor: pointer;
  }

  @media (hover: hover) {
    .search-modal__close:hover {
      background: var(--color-hover);
    }
  }

  .search-modal__results {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 var(--space-m) var(--space-m);
  }

  /* It drops in a little and fades up; with reduced motion it just appears. */
  @media (prefers-reduced-motion: no-preference) {
    .dialog.search-modal[open],
    .dialog.search-modal[open]::backdrop {
      transition:
        translate var(--duration) var(--ease-settle),
        opacity var(--duration) var(--ease),
        background-color var(--duration) var(--ease);
    }

    @starting-style {
      .dialog.search-modal[open] {
        translate: 0 -0.5rem;
        opacity: 0;
      }

      .dialog.search-modal[open]::backdrop {
        background-color: transparent;
      }
    }
  }

  .search-modal__results:focus-visible {
    outline: var(--focus-ring);
    outline-offset: calc(-1 * var(--focus-offset));
  }

  /* Nothing under the field until there is something to show. */
  .search-modal__results:empty {
    display: none;
  }
{% endstylesheet %}
