{% doc %}
  Renders a decorative Lucide-style icon in the current text colour.

  @param {string} name - account, alert, cart, check, chevron-down, minus or plus
  @param {string} [size] - sm, or blank for the default

  @example
  {% render 'icon', name: 'chevron-down', size: 'sm' %}
{% enddoc %}

<svg
  class="icon{% if size == 'sm' %} icon--sm{% endif %}"
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'alert' -%}
      <path d="M12 4 2.5 20h19L12 4Z"/><path d="M12 10v4M12 17h.01"/>
    {%- when 'check' -%}
      <path d="m5 12 5 5 9-10"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c1-5 4-7 8-7s7 2 8 7"/>
    {%- when 'cart' -%}
      <path d="M6 8h12l1 13H5L6 8Z"/><path d="M9 8a3 3 0 0 1 6 0"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'plus' -%}
      <path d="M5 12h14M12 5v14"/>
  {%- endcase -%}
</svg>

{% stylesheet %}
  .icon {
    display: block;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon--sm {
    width: 1rem;
    height: 1rem;
  }
{% endstylesheet %}
