{% doc %}
  Renders a product as a card: square image, title and price, with a sale or sold-out
  badge. The title is the card's one link, stretched over the whole card, so the image
  isn't a second link to the same page.

  @param {product} product - The product
  @param {string} sizes - The image's sizes attribute, from the grid's real columns
  @param {string} [heading_tag] - The title's heading element, default h3
  @param {string} [loading] - eager for cards in the first screen, default lazy

  @example
  {% render 'product-card', product: product, sizes: '(min-width: 900px) 22vw, 44vw' %}
{% enddoc %}

{%- liquid
  assign tag = heading_tag | default: 'h3'
  assign card_loading = loading | default: 'lazy'
-%}

<article class="product-card">
  <div class="product-card__media">
    {%- if product.featured_media -%}
      {% render 'image',
        image: product.featured_media,
        alt: '',
        sizes: sizes,
        aspect_ratio: '1',
        loading: card_loading
      %}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
    {%- endif -%}
  </div>
  <div class="product-card__body">
    <{{ tag }} class="product-card__title">
      <a class="product-card__link" href="{{ product.url }}">{{ product.title | escape }}</a>
    </{{ tag }}>
    {% render 'price', variant: product.selected_or_first_available_variant, range_product: product %}
  </div>
</article>

{% stylesheet %}
  .product-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-background);
  }

  .product-card__media {
    aspect-ratio: 1;
    background: var(--color-hover);
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    fill: var(--color-foreground-muted);
  }

  .product-card__body {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    padding: var(--space-s);
  }

  .product-card__title {
    margin: 0;
    font-size: var(--text-body);
    line-height: var(--leading-snug);
  }

  .product-card__link {
    color: inherit;
    text-decoration: none;
  }

  /* The one link covers the card, so the whole card is clickable. */
  .product-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .product-card__link:focus-visible {
    outline: none;
  }

  .product-card:has(.product-card__link:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  @media (hover: hover) {
    .product-card:hover .product-card__link {
      text-decoration: underline;
    }
  }
{% endstylesheet %}
