{% doc %}
  Renders an info button that shows extra detail in a native popover. Tap, Enter, Esc and
  clicking away come from the popover; assets/tooltip.js adds placement and mouse hover.
  For optional detail only: never the only place something is said.

  @param {string} id - Unique id for the bubble
  @param {string} label - The button's accessible name, already translated
  @param {string} text - The bubble text, already translated

  @example
  {% render 'tooltip', id: tip_id, label: tip_label, text: tip_text %}
{% enddoc %}

<tool-tip class="tooltip">
  <button
    class="tooltip__button"
    type="button"
    aria-label="{{ label | escape_once }}"
    aria-describedby="{{ id }}"
    popovertarget="{{ id }}"
  >
    {%- render 'icon', name: 'info', size: 'sm' -%}
  </button>
  <span class="tooltip__bubble" popover id="{{ id }}">{{ text | escape_once }}</span>
</tool-tip>

<script src="{{ 'tooltip.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .tooltip {
    display: inline-flex;
    align-self: center;
  }

  .tooltip__button {
    display: grid;
    place-items: center;
    width: var(--target-min);
    height: var(--target-min);
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: none;
    color: var(--color-foreground-muted);
    cursor: help;
    transition: background-color var(--duration) var(--ease);
  }

  @media (hover: hover) {
    .tooltip__button:hover {
      background: var(--color-hover);
      color: var(--color-foreground);
    }
  }

  .tooltip__bubble {
    width: max-content;
    max-width: min(15rem, 100vw - var(--control-pad-m));
    padding: var(--control-pad-xs) var(--control-pad-s);
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: var(--text-caption);
    font-weight: var(--weight-body);
    line-height: 1.4;
  }

  @media (forced-colors: active) {
    .tooltip__bubble {
      border: 1px solid CanvasText;
    }
  }
{% endstylesheet %}
