{%- liquid
  assign body = settings.type_body_font
  assign heading = settings.type_heading_font
  assign body_weight = body.weight | plus: 0

  assign body_bold = body | font_modify: 'weight', 'bolder'
  assign body_italic = body | font_modify: 'style', 'italic'
  assign body_bold_italic = body_bold | font_modify: 'style', 'italic'
  assign heading_italic = heading | font_modify: 'style', 'italic'
  assign heading_bold = heading | font_modify: 'weight', 'bolder'
  assign heading_bold_italic = heading_bold | font_modify: 'style', 'italic'

  if body_weight < 600
    assign ui_semibold = body | font_modify: 'weight', '600'
    assign ui_bold = body | font_modify: 'weight', 'bold'
  endif
  assign ui = ui_semibold | default: ui_bold | default: body

  assign body_font_url = body | font_url
  assign heading_font_url = heading | font_url
-%}

{% # theme-check-disable AssetPreload %}
{%- unless body.system? %}
  <link rel="preload" as="font" href="{{ body_font_url }}" type="font/woff2" crossorigin>
{%- endunless %}
{%- unless heading.system? or heading_font_url == body_font_url %}
  <link rel="preload" as="font" href="{{ heading_font_url }}" type="font/woff2" crossorigin>
{%- endunless %}
{% # theme-check-enable AssetPreload %}

{% style %}
  {{ body | font_face: font_display: 'swap' }}
  {{ body_bold | font_face: font_display: 'swap' }}
  {{ body_italic | font_face: font_display: 'swap' }}
  {{ body_bold_italic | font_face: font_display: 'swap' }}
  {%- unless ui.weight == body.weight or ui.weight == body_bold.weight %}
    {{ ui | font_face: font_display: 'swap' }}
  {%- endunless %}
  {{ heading | font_face: font_display: 'swap' }}
  {{ heading_italic | font_face: font_display: 'swap' }}
  {{ heading_bold | font_face: font_display: 'swap' }}
  {{ heading_bold_italic | font_face: font_display: 'swap' }}

  :root {
    --font-body: {{ body.family }}, {{ body.fallback_families }};
    --font-body-style: {{ body.style }};
    --font-heading: {{ heading.family }}, {{ heading.fallback_families }};
    --font-heading-style: {{ heading.style }};
    --weight-body: {{ body.weight }};
    --weight-ui: {{ ui.weight }};
    --weight-heading: {{ heading.weight }};
    --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --focus-offset: 2px;
    --layer-sticky: 8;
    --layer-temporary: 20;
    --shadow-stack: 0 -16px 40px rgb(0 0 0 / 0.25);

    --radius-button: {{ settings.button_radius }}px;
    --radius-sm: 6px;
    --radius-input: 8px;
    --radius-full: 999px;

    --control-h: 44px;
    --control-h-sm: 32px;
    --target-min: 24px;
    --swatch-inset: 3px;
    --control-pad-y: 0.25rem;
    --control-pad-xs: 0.5rem;
    --control-pad-s: 0.75rem;
    --control-pad-m: 1rem;
    --control-pad-l: 1.5rem;
    --select-pad-end: 2.5rem;
    --select-pad-end-sm: 1.75rem;
    --field-gap: 0.25rem;
    --badge-size: 1.125rem;
    --badge-pad: 0.25rem;
    --badge-pad-x: 0.5rem;
    --choice-size: 1rem;

    --duration: 0.2s;
    --duration-spin: 0.8s;
    --duration-settle: 1.2s;
    --ease: ease;
    --ease-linear: linear;
    --ease-settle: cubic-bezier(0.2, 0.7, 0.2, 1);
    --ease-step-end: step-end;
    --parallax-shift: {{ settings.parallax_strength }}svh;

    --text-h1: calc(clamp(2.25rem, 1.6rem + 3vw, 4rem) * var(--heading-scale));
    --text-h2: calc(clamp(1.75rem, 1.4rem + 1.8vw, 2.75rem) * var(--heading-scale));
    --text-h3: calc(clamp(1.5rem, 1.35rem + 0.75vw, 1.875rem) * var(--heading-scale));
    --text-h4: max(1.25rem, calc(clamp(1.25rem, 1.15rem + 0.4vw, 1.375rem) * var(--heading-scale)));
    --text-h5: max(var(--text-lg), calc(1.125rem * var(--heading-scale)));
    --text-product-title: calc(clamp(1.75rem, 1.3rem + 1.5vw, 2.5rem) * var(--heading-scale));
    --text-lg: 1.125rem;
    --text-body: 1rem;
    --text-small: 0.875rem;
    --text-caption: 0.8125rem;

    --space-2xs: 0.25rem;
    --space-xs: clamp(0.5rem, 0.45rem + 0.25vw, 0.75rem);
    --space-s: clamp(0.75rem, 0.65rem + 0.5vw, 1rem);
    --space-m: clamp(1rem, 0.85rem + 0.75vw, 1.5rem);
    --space-l: clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem);
    --space-xl: clamp(2rem, 1.5rem + 2.5vw, 4rem);
    --space-2xl: clamp(3rem, 2rem + 5vw, 6rem);
  }

  @media (prefers-reduced-motion: reduce) {
    :root {
      --duration: 0s;
    }
  }

  {% # The first scheme is also the page default %}
  {%- for scheme in settings.color_schemes %}
    {%- liquid
      if forloop.first
        echo ':root, '
      endif
      assign brightness = scheme.settings.background | color_brightness
    %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background }};
      --color-foreground: {{ scheme.settings.text }};
      --color-accent: {{ scheme.settings.accent }};
      --color-button: {{ scheme.settings.button }};
      --color-button-text: {{ scheme.settings.button_text }};
      --gradient-background: {{ scheme.settings.background_gradient | default: 'none' }};
      {% # color_brightness runs 0-255 %}
      {%- if brightness < 128 %}
        --color-error: #ff9c8a;
        --color-success: #8fd6a0;
        color-scheme: dark;
      {%- else %}
        --color-error: #8f1f13;
        --color-success: #1c5c32;
        color-scheme: light;
      {%- endif %}
      --color-foreground-muted: color-mix(in srgb, var(--color-foreground) 75%, var(--color-background));
      --color-control-border: color-mix(in srgb, var(--color-foreground) 55%, var(--color-background));
      --color-border: color-mix(in srgb, var(--color-foreground) 15%, var(--color-background));
      --color-hover: color-mix(in srgb, var(--color-foreground) 8%, transparent);
      --color-active: color-mix(in srgb, var(--color-foreground) 14%, transparent);
      --focus-ring: 3px solid var(--color-accent);
    }

    {% # :where() keeps specificity at zero so a component's own background wins %}
    :where(.color-{{ scheme.id }}) {
      background-color: var(--color-background);
      background-image: var(--gradient-background);
      color: var(--color-foreground);
    }
  {%- endfor %}

  :root {
    background-color: var(--color-background);
    color: var(--color-foreground);
  }
{% endstyle %}
