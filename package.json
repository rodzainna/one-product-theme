{
  "name": "one-product-theme",
  "private": true,
  "description": "Industry-agnostic single-product Shopify theme built on Skeleton",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "dev": "shopify theme dev",
    "check": "shopify theme check --fail-level suggestion && pnpm lint:css",
    "lint:css": "node scripts/lint-css.mjs",
    "test": "vitest run",
    "test:store": "vitest run --config vitest.store.config.mjs",
    "test:store:setup": "node scripts/test-store-setup.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@shopify/prettier-plugin-liquid": "^1.11.6",
    "@vitest/browser-playwright": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "vitest": "^5.1.0"
  }
}
