<!doctype html>
{%- liquid
  assign template_name = template.name
  if template.suffix != blank
    assign template_name = template_name | append: '.' | append: template.suffix
  endif
  assign scroll_templates = 'index,page.about,page.reviews,page.compare' | split: ','
  assign html_classes = ''
  assign stack = false
  assign dots = false
  if scroll_templates contains template_name
    if settings.scroll_snap
      assign html_classes = html_classes | append: ' snap'
    endif
    if settings.stack_sections
      assign html_classes = html_classes | append: ' stack'
      assign stack = true
      if settings.section_dots
        assign html_classes = html_classes | append: ' dots'
        assign dots = true
      endif
    endif
  endif
  if settings.sticky_header
    assign html_classes = html_classes | append: ' header-sticky'
  endif
  assign html_classes = html_classes | strip
-%}
<html
  lang="{{ request.locale.iso_code }}"
  {% if html_classes != blank %}
    class="{{ html_classes }}"
  {% endif %}
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% # Shopify's standard storefront events, so apps can follow what the shopper does %}
    <script type="importmap">
      {
        "imports": {
          "@shopify/standard-events": "https://cdn.shopify.com/storefront/standard-events.js",
          "dialog": "{{ 'dialog.js' | asset_url }}"
        }
      }
    </script>

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      <script>
        // Apps that ask to show the cart get the drawer.
        document.addEventListener('DOMContentLoaded', () => {
          window.Shopify?.actions?.openCart?.configure({
            handler: () => import('dialog').then(({ openDialog }) => openDialog(document.getElementById('CartDrawer'))),
          });
        });
      </script>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    <div class="header-group">
      {% sections 'header-group' %}
    </div>
    <script>
      // Measured before first paint so the first section doesn't jump; header-height.js keeps them current.
      (() => {
        const group = document.querySelector('.header-group');
        const header = group.querySelector('.site-header');
        let above = 0;
        for (const section of group.children) {
          if (section.contains(header)) break;
          above += section.offsetHeight;
        }
        const style = document.documentElement.style;
        style.setProperty('--header-group-h', group.offsetHeight + 'px');
        style.setProperty('--header-above-h', above + 'px');
        style.setProperty('--header-h', group.offsetHeight - above + 'px');
      })();
    </script>
    <script type="module">
      import { trackHeaderHeight } from '{{ 'header-height.js' | asset_url }}';
      trackHeaderHeight();
    </script>

    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- if dots -%}
      <nav
        class="section-dots"
        aria-label="{{ 'accessibility.page_sections' | t }}"
        data-fallback-label="{{ 'accessibility.section_number' | t: number: '[number]' }}"
      >
        <ol></ol>
      </nav>
    {%- endif -%}
    {%- if stack -%}
      <script type="module">
        import { stackSections } from '{{ 'stacked-sections.js' | asset_url }}';
        stackSections();
      </script>
    {%- endif -%}
    {%- if dots -%}
      <script type="module">
        import { sectionDots } from '{{ 'section-dots.js' | asset_url }}';
        sectionDots();
      </script>
    {%- endif -%}

    <div class="footer-group">
      {% sections 'footer-group' %}
    </div>
  </body>
</html>
