<!doctype html>
{%- liquid
  assign template_name = template.name
  if template.suffix != blank
    assign template_name = template_name | append: '.' | append: template.suffix
  endif
  assign scroll_templates = 'index,page.about,page.reviews,page.compare' | split: ','
  assign scroll_classes = ''
  assign stack = false
  assign dots = false
  if scroll_templates contains template_name
    if settings.scroll_snap
      assign scroll_classes = scroll_classes | append: ' snap'
    endif
    if settings.stack_sections
      assign scroll_classes = scroll_classes | append: ' stack'
      assign stack = true
      if settings.section_dots
        assign scroll_classes = scroll_classes | append: ' dots'
        assign dots = true
      endif
    endif
  endif
  assign scroll_classes = scroll_classes | strip
-%}
<html
  lang="{{ request.locale.iso_code }}"
  {% if scroll_classes != blank %}
    class="{{ scroll_classes }}"
  {% endif %}
>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% # Shopify's standard storefront events, so apps can follow what the shopper does %}
    <script type="importmap">
      {
        "imports": {
          "@shopify/events": "https://cdn.shopify.com/storefront/standard-events.js",
          "dialog": "{{ 'dialog.js' | asset_url }}"
        }
      }
    </script>

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    <div class="header-group">
      {% sections 'header-group' %}
    </div>
    <script>
      // Measured before first paint so the first section doesn't jump; header-height.js keeps it current.
      document.documentElement.style.setProperty(
        '--header-group-h',
        document.querySelector('.header-group').offsetHeight + 'px',
      );
    </script>
    <script type="module">
      import { trackHeaderHeight } from '{{ 'header-height.js' | asset_url }}';
      trackHeaderHeight();
    </script>

    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    {%- if dots -%}
      <nav
        class="section-dots"
        aria-label="{{ 'accessibility.page_sections' | t }}"
        data-fallback-label="{{ 'accessibility.section_number' | t: number: '[number]' }}"
      >
        <ol></ol>
      </nav>
    {%- endif -%}
    {%- if stack -%}
      <script type="module">
        import { stackSections } from '{{ 'stacked-sections.js' | asset_url }}';
        stackSections();
      </script>
    {%- endif -%}
    {%- if dots -%}
      <script type="module">
        import { sectionDots } from '{{ 'section-dots.js' | asset_url }}';
        sectionDots();
      </script>
    {%- endif -%}

    <div class="footer-group">
      {% sections 'footer-group' %}
    </div>
  </body>
</html>
