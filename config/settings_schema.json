[
  {
    "name": "theme_info",
    "theme_name": "One Product",
    "theme_version": "0.1.0",
    "theme_author": "Rodzainna Hamisain",
    "theme_documentation_url": "https://github.com/rodzainna/one-product-theme#readme",
    "theme_support_url": "https://github.com/rodzainna/one-product-theme/issues"
  },
  {
    "name": "t:general.favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:general.favicon",
        "info": "t:info.favicon"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "fraunces_n7",
        "label": "t:labels.headings"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "inter_n4",
        "label": "t:labels.body"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100,
        "label": "t:labels.heading_scale"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "narrow",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "wide",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "narrow"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "checkbox",
        "id": "sticky_header",
        "label": "t:labels.sticky_header",
        "info": "t:info.sticky_header",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.scrolling",
    "settings": [
      {
        "type": "checkbox",
        "id": "scroll_snap",
        "label": "t:labels.scroll_snap",
        "info": "t:info.scroll_snap",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "stack_sections",
        "label": "t:labels.stack_sections",
        "info": "t:info.stack_sections",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "section_dots",
        "label": "t:labels.section_dots",
        "info": "t:info.section_dots",
        "default": true,
        "visible_if": "{{ settings.stack_sections }}"
      },
      {
        "type": "range",
        "id": "parallax_strength",
        "min": 5,
        "max": 30,
        "step": 1,
        "unit": "%",
        "label": "t:labels.parallax_strength",
        "info": "t:info.parallax_strength",
        "default": 25
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:labels.background",
            "default": "#F6F0E6"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:labels.background_gradient",
            "info": "t:info.background_gradient"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:labels.text",
            "default": "#2A1D15"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "t:labels.accent",
            "default": "#A8410F"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:labels.button",
            "default": "#A8410F"
          },
          {
            "type": "color",
            "id": "button_text",
            "label": "t:labels.button_text",
            "default": "#FFFFFF"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "accent",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_text",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text"
        }
      }
    ]
  },
  {
    "name": "t:general.buttons",
    "settings": [
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 40,
        "label": "t:labels.button_radius"
      },
      {
        "type": "select",
        "id": "secondary_button_style",
        "label": "t:labels.secondary_button_style",
        "options": [
          {
            "value": "outline",
            "label": "t:options.button_style.outline"
          },
          {
            "value": "solid",
            "label": "t:options.button_style.solid"
          }
        ],
        "default": "outline"
      }
    ]
  },
  {
    "name": "t:general.cards_and_media",
    "settings": [
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 12,
        "label": "t:labels.corner_radius"
      }
    ]
  },
  {
    "name": "t:general.cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:labels.cart_type",
        "info": "t:info.cart_type",
        "options": [
          {
            "value": "drawer",
            "label": "t:options.cart_type.drawer"
          },
          {
            "value": "page",
            "label": "t:options.cart_type.page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_note",
        "label": "t:labels.show_cart_note",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_dynamic_checkout",
        "label": "t:labels.show_dynamic_checkout",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.gift_card",
    "settings": [
      {
        "type": "image_picker",
        "id": "gift_card_logo",
        "label": "t:labels.logo",
        "info": "t:info.logo"
      },
      {
        "type": "range",
        "id": "gift_card_logo_max_width",
        "min": 40,
        "max": 192,
        "step": 8,
        "unit": "px",
        "label": "t:labels.logo_max_width",
        "info": "t:info.gift_card_logo_max_width",
        "default": 192,
        "visible_if": "{{ settings.gift_card_logo != blank }}"
      },
      {
        "type": "range",
        "id": "gift_card_logo_max_height",
        "min": 24,
        "max": 120,
        "step": 8,
        "unit": "px",
        "label": "t:labels.logo_max_height",
        "default": 80,
        "visible_if": "{{ settings.gift_card_logo != blank }}"
      }
    ]
  },
  {
    "name": "t:general.social_media",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:info.social_media"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "t:labels.social_instagram"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "t:labels.social_facebook"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "t:labels.social_tiktok"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "t:labels.social_youtube"
      },
      {
        "type": "url",
        "id": "social_pinterest",
        "label": "t:labels.social_pinterest"
      },
      {
        "type": "url",
        "id": "social_x",
        "label": "t:labels.social_x"
      }
    ]
  }
]
