{% doc %}
  Renders the product's star rating and review count from the standard reviews.rating and
  reviews.rating_count metafields, which most review apps fill in. Renders nothing without a
  rating, except a note in the theme editor.

  @example
  {% content_for 'block', type: '_product-rating', id: 'rating' %}
{% enddoc %}

{%- liquid
  assign current_product = closest.product
  assign rating = current_product.metafields.reviews.rating.value
  assign rating_count = current_product.metafields.reviews.rating_count.value | default: 0
-%}

{%- if rating != blank -%}
  {%- liquid
    assign scale_max = rating.scale_max | default: 5 | round: 1
    assign scale_label = scale_max | round
    if scale_label != scale_max
      assign scale_label = scale_max
    endif
    assign score = rating.rating | round: 1
    assign percent = rating.rating | divided_by: scale_max | times: 100 | round: 1
    assign wrapper = 'p'
    if block.settings.reviews_url != blank
      assign wrapper = 'a'
    endif
  -%}
  <{{ wrapper }}
    class="product-rating"
    {% if wrapper == 'a' %}
      href="{{ block.settings.reviews_url | escape }}"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {% render 'rating-stars', percent: percent %}
    <span class="visually-hidden">{{ 'products.product.rating' | t: score: score, max: scale_label }}</span>
    <span aria-hidden="true">{{ score }}</span>
    {%- if rating_count > 0 -%}
      <span>· {{ 'products.product.reviews_count' | t: count: rating_count }}</span>
    {%- endif -%}
  </{{ wrapper }}>
{%- elsif request.design_mode -%}
  <p class="product-rating product-rating--empty" {{ block.shopify_attributes }}>
    {{ 'products.product.no_rating' | t }}
  </p>
{%- endif -%}

{% stylesheet %}
  .product-rating {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    align-items: center;
    justify-self: start;
    min-height: var(--target-min);
    margin: 0;
    color: inherit;
    font-size: var(--text-small);
    text-decoration: none;
  }

  @media (hover: hover) {
    a.product-rating:hover {
      text-decoration: underline;
    }
  }

  .product-rating--empty {
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.rating",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:info.rating"
    },
    {
      "type": "url",
      "id": "reviews_url",
      "label": "t:labels.reviews_link",
      "info": "t:info.reviews_link"
    }
  ],
  "presets": [{ "name": "t:general.rating" }]
}
{% endschema %}
