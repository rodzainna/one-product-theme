{% doc %}
  A footer email sign-up. Shopify's customer form creates a customer who accepts marketing; it
  works without scripting, and the page reloads to the form with a thank-you or the errors.
  It can also show Shopify's Follow on Shop button, which prints nothing until the store has it on.
  https://shopify.dev/docs/storefronts/themes/customer-engagement/email-consent
  https://shopify.dev/docs/api/liquid/filters/login_button

  @example
  {% content_for 'block', type: '_newsletter', id: 'newsletter' %}
{% enddoc %}

{%- liquid
  assign form_id = 'Newsletter-' | append: block.id
  assign field_id = form_id | append: '-email'
  assign button_label = block.settings.button_label
  if button_label == blank
    assign button_label = 'footer.newsletter.subscribe' | t
  endif
  assign success_text = block.settings.success_text
  if success_text == blank
    assign success_text = 'footer.newsletter.success' | t
  endif
  assign email_label = 'footer.newsletter.email' | t
  assign form_name = block.settings.heading
  if form_name == blank
    assign form_name = 'footer.newsletter.label' | t
  endif
  assign follow_button = null
  if block.settings.show_follow_on_shop
    assign follow_button = shop | login_button: action: 'follow'
  endif
-%}

<div class="newsletter" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <h2 class="newsletter__heading">{{ block.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if block.settings.text != blank -%}
    <p class="newsletter__text">{{ block.settings.text | escape }}</p>
  {%- endif -%}

  {% form 'customer', id: form_id, class: 'newsletter__form', aria-label: form_name %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {%- if form.posted_successfully? -%}
      {% render 'message', type: 'success', text: success_text, focus: true %}
    {%- else -%}
      {%- if form.errors -%}
        {% render 'message', type: 'error', errors: form.errors, id_prefix: form_id %}
      {%- endif -%}
      <div class="newsletter__row">
        {% render 'input',
          id: field_id,
          label: email_label,
          label_hidden: true,
          type: 'email',
          name: 'contact[email]',
          value: form.email,
          placeholder: email_label,
          autocomplete: 'email',
          required: true,
          errors: form.errors,
          field: 'email'
        %}
        {% render 'button', label: button_label, type: 'submit' %}
      </div>
    {%- endif -%}
  {% endform %}

  {%- if follow_button != blank -%}
    <div class="newsletter__follow">{{ follow_button }}</div>
  {%- elsif block.settings.show_follow_on_shop and request.design_mode -%}
    <p class="newsletter__hint">{{ 'footer.newsletter.follow_unavailable' | t }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .newsletter__heading {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: var(--leading-heading);
  }

  .newsletter__text {
    margin: 0 0 var(--space-s);
    font-size: var(--text-small);
    overflow-wrap: anywhere;
  }

  .newsletter__form {
    display: grid;
    gap: var(--space-s);
  }

  .newsletter__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    align-items: start;
  }

  .newsletter__follow,
  .newsletter__hint {
    margin: var(--space-s) 0 0;
  }

  .newsletter__hint {
    font-size: var(--text-small);
  }

  .newsletter__row > .field {
    flex: 1 1 10rem;
    min-inline-size: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Subscribe to our emails"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text",
      "default": "News and offers, straight to your inbox."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "info": "t:info.newsletter_button"
    },
    {
      "type": "checkbox",
      "id": "show_follow_on_shop",
      "label": "t:labels.show_follow_on_shop",
      "info": "t:info.show_follow_on_shop",
      "default": true
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "t:labels.success_text",
      "info": "t:info.newsletter_success"
    }
  ]
}
{% endschema %}
