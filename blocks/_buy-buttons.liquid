{% doc %}
  Renders the product form: variant id, purchase options, quantity, Add to cart and
  accelerated checkout. Add to cart reads "Sold out" or "Unavailable" and is disabled
  when the selected variant can't be bought, and accelerated checkout is hidden. On a
  variant change, assets/variant-picker.js swaps each data-variant-region, sets the id
  input's value (data-variant-value) and copies hidden onto data-variant-hidden, whose
  content Shopify's own script fills.

  @example
  {% content_for 'block', type: '_buy-buttons', id: 'buy_buttons' %}
{% enddoc %}

{%- liquid
  assign current_product = closest.product
  assign current_variant = current_product.selected_or_first_available_variant
  assign selected_allocation = current_variant.selected_selling_plan_allocation
  # Shopify sets the variant's plan only when the URL names a variant; ?selling_plan= alone sets the product's.
  if selected_allocation == blank and current_product.selected_selling_plan
    for candidate in current_variant.selling_plan_allocations
      if candidate.selling_plan.id == current_product.selected_selling_plan.id
        assign selected_allocation = candidate
        break
      endif
    endfor
  endif
  if selected_allocation == blank and current_product.requires_selling_plan
    assign selected_allocation = current_variant.selling_plan_allocations.first
  endif
  assign selected_plan_id = selected_allocation.selling_plan.id
  assign id_suffix = section.id | append: '-' | append: block.id
-%}

<div class="buy-buttons" {{ block.shopify_attributes }}>
  {%- assign form_id = 'Product-form-' | append: id_suffix -%}
  {% form 'product', current_product, id: form_id, class: 'buy-buttons__form' %}
    <input
      type="hidden"
      name="id"
      value="{{ current_variant.id }}"
      id="Product-id-{{ id_suffix }}"
      data-variant-value
    >

    <div class="buy-buttons__plans" id="Product-plans-{{ id_suffix }}" data-variant-region>
      {%- if current_variant.selling_plan_allocations.size > 0 -%}
        {%- liquid
          assign plan_prefix = 'Product-plan-' | append: id_suffix
          assign one_time_id = plan_prefix | append: '-once'
          assign one_time_label = 'products.product.one_time_purchase' | t
          assign one_time_price = current_variant.price | money | strip_html
          assign one_time_checked = false
          if selected_plan_id == blank
            assign one_time_checked = true
          endif
        -%}
        <fieldset class="choice-group choice-group--cards">
          <legend>{{ 'products.product.purchase_options' | t }}</legend>
          {%- unless current_product.requires_selling_plan -%}
            {% render 'radio',
              id: one_time_id,
              name: 'selling_plan',
              value: '',
              label: one_time_label,
              hint: one_time_price,
              checked: one_time_checked,
              variant: 'card'
            %}
          {%- endunless -%}
          {%- comment -%} Plans in their admin groups, each group named when there's more than one. {%- endcomment -%}
          {%- liquid
            # Only groups with plans for this variant count, and only they are shown.
            assign group_count = 0
            for group in current_product.selling_plan_groups
              assign group_allocations = current_variant.selling_plan_allocations | where: 'selling_plan_group_id', group.id
              if group_allocations.size > 0
                assign group_count = group_count | plus: 1
              endif
            endfor
            assign grouped = false
            if group_count > 1
              assign grouped = true
            endif
          -%}
          {%- for group in current_product.selling_plan_groups -%}
            {%- assign group_allocations = current_variant.selling_plan_allocations
              | where: 'selling_plan_group_id', group.id
            -%}
            {%- if group_allocations.size == 0 -%}
              {%- continue -%}
            {%- endif -%}
            {%- if grouped -%}
              <fieldset class="choice-group choice-group--cards buy-buttons__plan-group">
                <legend>{{ group.name | escape }}</legend>
            {%- endif -%}
            {%- for allocation in group_allocations -%}
              {%- liquid
                assign plan = allocation.selling_plan
                assign plan_id = plan_prefix | append: '-' | append: plan.id
                # A prepaid plan charges several deliveries at checkout.
                assign plan_price = allocation.per_delivery_price | money | strip_html
                if allocation.checkout_charge_amount != allocation.per_delivery_price
                  assign plan_total = allocation.checkout_charge_amount | money | strip_html
                  assign plan_price = 'products.product.plan_prepaid' | t: price: plan_price, total: plan_total
                endif
                assign plan_checked = false
                if plan.id == selected_plan_id
                  assign plan_checked = true
                endif
              -%}
              {% render 'radio',
                id: plan_id,
                name: 'selling_plan',
                value: plan.id,
                label: plan.name,
                hint: plan_price,
                checked: plan_checked,
                variant: 'card'
              %}
            {%- endfor -%}
            {%- if grouped -%}
              </fieldset>
            {%- endif -%}
          {%- endfor -%}
        </fieldset>
      {%- endif -%}
    </div>

    {%- if current_product.gift_card? -%}
      {% render 'gift-card-recipient', id_suffix: id_suffix %}
    {%- endif -%}

    <div class="buy-buttons__row">
      {%- liquid
        # B2B quantity rules count what's already in the cart: the rest of the minimum, up to the maximum.
        assign quantity_rule = current_variant.quantity_rule
        assign in_cart = 0
        assign quantity_min = 1
        if current_variant != blank
          assign in_cart = cart.items | where: 'variant_id', current_variant.id | map: 'quantity' | sum
          assign quantity_min = quantity_rule.min | minus: in_cart | at_least: quantity_rule.increment
        endif
        assign quantity_max = null
        assign max_reached = false
        if quantity_rule.max != blank
          assign quantity_max = quantity_rule.max | minus: in_cart
          if quantity_max < quantity_min
            assign max_reached = true
          endif
        endif
        assign quantity_id = 'Product-quantity-' | append: id_suffix
        assign rules_id = 'Product-rules-' | append: id_suffix
        assign quantity_attributes = 'data-variant-attributes="min max step disabled" aria-describedby="' | append: rules_id | append: '"'
        assign quantity_label = 'products.product.quantity' | t
        assign quantity_disabled = true
        if current_product.available and max_reached == false
          assign quantity_disabled = false
        endif
        assign add_label = 'products.product.add_to_cart' | t
        assign add_disabled = false
        if current_variant == blank
          assign add_label = 'products.product.unavailable' | t
          assign add_disabled = true
        elsif current_variant.available == false
          assign add_label = 'products.product.sold_out' | t
          assign add_disabled = true
        elsif max_reached
          assign add_label = 'products.product.max_in_cart' | t
          assign add_disabled = true
        endif
        assign add_attributes = 'id="Product-add-' | append: id_suffix | append: '" data-variant-region'
      -%}
      {% render 'quantity-input',
        id: quantity_id,
        label: quantity_label,
        label_hidden: true,
        disabled: quantity_disabled,
        min: quantity_min,
        max: quantity_max,
        step: quantity_rule.increment,
        input_attributes: quantity_attributes
      %}
      {% render 'button',
        label: add_label,
        type: 'submit',
        name: 'add',
        disabled: add_disabled,
        attributes: add_attributes
      %}
    </div>
    <p class="buy-buttons__rules" id="{{ rules_id }}" data-variant-region>
      {%- if quantity_rule.min > 1 or quantity_rule.increment > 1 or quantity_rule.max != blank -%}
        {%- liquid
          assign rules = ''
          if quantity_rule.min > 1
            assign rules = 'products.product.quantity_minimum' | t: count: quantity_rule.min
          endif
          if quantity_rule.max != blank
            assign rule_text = 'products.product.quantity_maximum' | t: count: quantity_rule.max
            assign rules = rules | append: ' · ' | append: rule_text
          endif
          if quantity_rule.increment > 1
            assign rule_text = 'products.product.quantity_increment' | t: count: quantity_rule.increment
            assign rules = rules | append: ' · ' | append: rule_text
          endif
          if in_cart > 0
            assign rule_text = 'products.product.quantity_in_cart' | t: count: in_cart
            assign rules = rules | append: ' · ' | append: rule_text
          endif
          assign rules = rules | remove_first: ' · '
        -%}
        {{ rules }}
      {%- endif -%}
    </p>
    {%- if block.settings.show_dynamic_checkout -%}
      <div
        class="buy-buttons__accelerated{% if settings.secondary_button_style == 'solid' %} buy-buttons__accelerated--solid{% endif %}"
        id="Product-accelerated-{{ id_suffix }}"
        data-variant-hidden
        {% if add_disabled %}
          hidden
        {% endif %}
      >
        {{ form | payment_button }}
      </div>
    {%- endif -%}
    {{ form | payment_terms }}
  {% endform %}

  {%- if block.settings.show_sticky_bar -%}
    {%- liquid
      assign sticky_add_attributes = 'id="Sticky-add-' | append: id_suffix | append: '" form="' | append: form_id | append: '"'
    -%}
    <sticky-add-to-cart class="sticky-bar" data-button="Product-add-{{ id_suffix }}" popover="manual">
      <div class="sticky-bar__inner" id="Sticky-{{ id_suffix }}" data-variant-region>
        {%- assign sticky_media = current_variant.featured_media | default: current_product.featured_media -%}
        {%- if sticky_media != blank -%}
          {{
            sticky_media.preview_image
            | image_url: width: 96, height: 96, crop: 'center'
            | image_tag: alt: '', loading: 'lazy', width: 48, height: 48, class: 'sticky-bar__image'
          }}
        {%- endif -%}
        <div class="sticky-bar__text">
          <p class="sticky-bar__title">{{ current_product.title | escape }}</p>
          {%- unless current_product.has_only_default_variant or current_variant == blank -%}
            <p class="sticky-bar__variant">{{ current_variant.title | escape }}</p>
          {%- endunless -%}
        </div>
        {%- if current_variant != blank -%}
          <div class="sticky-bar__price">
            {% render 'price', variant: current_variant, allocation: selected_allocation %}
          </div>
        {%- endif -%}
        {% render 'button',
          label: add_label,
          type: 'submit',
          name: 'add',
          disabled: add_disabled,
          attributes: sticky_add_attributes
        %}
      </div>
    </sticky-add-to-cart>
    <script src="{{ 'sticky-add-to-cart.js' | asset_url }}" type="module"></script>
  {%- endif -%}
</div>

{% stylesheet %}
  /* A manual popover in the top layer, so stacked sections sliding over the buy box can't cover it. */
  .sticky-bar {
    position: fixed;
    inset: auto 0 0;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-block-start: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .sticky-bar__inner {
    display: flex;
    gap: var(--space-s);
    align-items: center;
    width: min(100% - 2 * var(--page-margin), var(--page-width));
    margin-inline: auto;
    padding-block: var(--space-xs);
  }

  .sticky-bar__image {
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-sm);
    object-fit: cover;
  }

  .sticky-bar__text {
    flex: 1;
    min-width: 0;
  }

  .sticky-bar p {
    margin: 0;
  }

  .sticky-bar__title {
    overflow: hidden;
    font-weight: var(--weight-ui);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sticky-bar__variant {
    color: var(--color-foreground-muted);
    font-size: var(--text-small);
  }

  .sticky-bar__price {
    font-weight: var(--weight-ui);
  }

  /* Phones: room for the name and the button. */
  @media (max-width: 599px) {
    .sticky-bar__image,
    .sticky-bar__price {
      display: none;
    }
  }

  .buy-buttons__form {
    display: grid;
    gap: var(--space-s);
  }

  /* No box of its own, so an empty one adds no gap. */
  .buy-buttons__plans {
    display: contents;
  }

  .buy-buttons__row {
    display: flex;
    gap: var(--space-xs);
  }

  .buy-buttons__row .button {
    flex: 1;
  }

  .buy-buttons__plan-group legend {
    color: var(--color-foreground-muted);
    font-size: var(--text-small);
  }

  .buy-buttons__rules {
    margin: 0;
    color: var(--color-foreground-muted);
    font-size: var(--text-small);
  }

  .buy-buttons__rules:empty {
    display: none;
  }

  /* Shopify's plain Buy it now, styled as the theme's secondary button; branded ones keep their look. */
  .buy-buttons__accelerated .shopify-payment-button__button--unbranded {
    min-height: var(--control-h);
    padding: var(--control-pad-y) var(--control-pad-l);
    border: 2px solid var(--color-foreground);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: var(--weight-ui);
    transition: background-color var(--duration) var(--ease);
  }

  .buy-buttons__accelerated--solid .shopify-payment-button__button--unbranded {
    background: var(--color-foreground);
    color: var(--color-background);
  }

  @media (hover: hover) {
    .buy-buttons__accelerated .shopify-payment-button__button--unbranded:hover:not([disabled]) {
      background: var(--color-hover);
    }

    .buy-buttons__accelerated--solid .shopify-payment-button__button--unbranded:hover:not([disabled]) {
      background: var(--color-foreground);
      opacity: 0.9;
    }
  }

  .buy-buttons__accelerated .shopify-payment-button__button--unbranded:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.buy_buttons",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_sticky_bar",
      "label": "t:labels.show_sticky_bar",
      "info": "t:info.show_sticky_bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:labels.show_dynamic_checkout",
      "info": "t:info.show_dynamic_checkout",
      "default": true
    }
  ],
  "presets": [{ "name": "t:general.buy_buttons" }]
}
{% endschema %}
