{% doc %}
  One tile in the link tiles section: a photo with a title and a short line over a dark gradient,
  linking to a page. It renders a plain tile, not a link, while no link is set.

  @example
  {% content_for 'block', type: '_tile', id: 'tile' %}
{% enddoc %}

{%- liquid
  assign tag = 'div'
  if block.settings.link != blank
    assign tag = 'a'
  endif

  assign image_sizes = '(min-width: 900px) 50vw, 100vw'
  if section.blocks.size == 1
    assign image_sizes = '100vw'
  endif
-%}
<{{ tag }}
  class="tile"
  {% if tag == 'a' %}
    href="{{ block.settings.link | escape }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.image != blank -%}
    {% render 'image', image: block.settings.image, alt: '', class: 'tile__image', sizes: image_sizes %}
  {%- endif -%}
  <div class="tile__text">
    {%- if tag == 'a' and block.settings.title == blank -%}
      {%- if block.settings.image.alt != blank -%}
        <span class="visually-hidden">{{ block.settings.image.alt | escape }}</span>
      {%- elsif block.settings.tags == blank -%}
        <span class="visually-hidden">{{ 'link_tiles.read_more' | t }}</span>
      {%- endif -%}
    {%- endif -%}
    {%- if block.settings.title != blank -%}
      <h3 class="tile__title">
        {{- block.settings.title | escape -}}
        {%- if tag == 'a' -%}
          <span class="tile__arrow" aria-hidden="true"> ›</span>
        {%- endif -%}
      </h3>
    {%- endif -%}
    {%- if block.settings.tags != blank -%}
      <span class="tile__tags">{{ block.settings.tags | escape }}</span>
    {%- endif -%}
  </div>
</{{ tag }}>

{% stylesheet %}
  .tile {
    position: relative;
    display: flex;
    flex: 1;
    align-items: flex-end;
    min-height: 34svh;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-scrim);
    color: var(--color-on-scrim);
    text-decoration: none;
  }
  .tile__image {
    position: absolute;
    inset: 0;
  }
  .tile .tile__image > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile__image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      color-mix(in srgb, var(--color-scrim) var(--tiles-gradient, 85%), transparent),
      color-mix(in srgb, var(--color-scrim) calc(var(--tiles-gradient, 85%) * 0.18), transparent) 70%
    );
  }
  .tile__text {
    position: relative;
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-l);
  }
  .tile__title {
    margin: 0;
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
  }
  .tile__arrow {
    color: var(--color-accent);
  }
  .tile__tags {
    color: color-mix(in srgb, var(--color-on-scrim) 85%, transparent);
    font-size: var(--text-small);
  }
  a.tile:focus-visible {
    outline: var(--focus-ring);
    outline-color: var(--color-on-scrim);
    outline-offset: -4px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tile .tile__image > img {
      transition: transform var(--duration-zoom) var(--ease);
    }
    a.tile:hover .tile__image > img,
    a.tile:focus-visible .tile__image > img {
      transform: scale(1.05);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.tile",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.title",
      "default": "A tile"
    },
    {
      "type": "text",
      "id": "tags",
      "label": "t:labels.tags",
      "info": "t:info.tile_tags"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "presets": [
    {
      "name": "t:general.tile"
    }
  ]
}
{% endschema %}
