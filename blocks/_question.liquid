{% doc %}
  One question and its answer, shown as an accordion item. The section's "Open one question at a
  time" and "Open the first question" settings apply when it has them. Nothing shows until the
  question has text.

  @example
  {% content_for 'block', type: '_question', id: 'question' %}
{% enddoc %}

{%- if block.settings.question != blank -%}
  {%- liquid
    assign group = ''
    if section.settings.one_at_a_time
      assign group = section.id
    endif
    assign is_open = false
    if section.settings.open_first and section.blocks.first.id == block.id
      assign is_open = true
    endif
  -%}
  {% render 'accordion-item',
    summary: block.settings.question,
    content: block.settings.answer,
    group: group,
    open: is_open,
    shopify_attributes: block.shopify_attributes
  %}
{%- elsif request.design_mode -%}
  <div {{ block.shopify_attributes }}></div>
{%- endif -%}

{% schema %}
{
  "name": "t:general.question",
  "settings": [
    {
      "type": "text",
      "id": "question",
      "label": "t:labels.question",
      "default": "Your question"
    },
    {
      "type": "richtext",
      "id": "answer",
      "label": "t:labels.answer",
      "default": "<p>A short, clear answer.</p>"
    }
  ]
}
{% endschema %}
