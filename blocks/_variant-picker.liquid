{% doc %}
  Renders each product option as pills, as swatches when every value has a swatch
  (colour or image, from the option's category metafield), or as a dropdown when its
  style setting says so. assets/variant-picker.js re-renders the section for the picked
  option values and updates the price, buy buttons and URL, also when a selling plan is
  picked. Hidden, with no options, when the product has only the default variant.

  @example
  {% content_for 'block', type: '_variant-picker', id: 'variant_picker' %}
{% enddoc %}

{%- liquid
  assign current_product = closest.product
  assign current_variant = current_product.selected_or_first_available_variant
  assign id_suffix = section.id | append: '-' | append: block.id
  assign size_guide_id = 'SizeGuide-' | append: id_suffix
  assign size_guide_heading = block.settings.size_guide_heading | default: 'products.product.size_guide' | t
  assign size_guide_option = block.settings.size_guide_option | strip | downcase
  assign size_guide_html = ''
  assign size_guide_shown = false
  if block.settings.size_guide_content != blank and current_product.has_only_default_variant == false
    for option in current_product.options_with_values
      assign option_name = option.name | strip | downcase
      if option_name == size_guide_option
        assign size_guide_shown = true
      endif
    endfor
  endif
  if size_guide_shown
    capture size_guide_html
      echo '<button type="button" class="link-button" aria-haspopup="dialog" data-dialog-open="'
      echo size_guide_id
      echo '">'
      echo size_guide_heading | escape
      echo '</button>'
    endcapture
  endif
-%}

{%- comment -%} Hidden with no options for a single-variant product, where it still re-prices selling plans. {%- endcomment -%}
<variant-picker
  class="variant-picker"
  id="VariantPicker-{{ id_suffix }}"
  data-url="{{ current_product.url }}"
  data-section-id="{{ section.id }}"
  data-variant-id="{{ current_variant.id }}"
  {% if template.name == 'product' and product.id == current_product.id %}
    data-update-url
  {% endif %}
  {% if current_product.has_only_default_variant %}
    hidden
  {% endif %}
  {{ block.shopify_attributes }}
>
  <script type="application/json" data-event-data>
    {{ current_product | standard_event_data: 'view', context: 'page' }}
  </script>
  {%- unless current_product.has_only_default_variant -%}
    {%- for option in current_product.options_with_values -%}
      {%- liquid
        assign group_name = 'Option-' | append: id_suffix | append: '-' | append: option.position
        assign style_key = 'option_' | append: option.position | append: '_style'
        assign option_name = option.name | strip | downcase
        assign option_aside = ''
        if option_name == size_guide_option
          assign option_aside = size_guide_html
        endif
      -%}
      {%- if block.settings[style_key] == 'dropdown' -%}
        {%- capture value_options -%}
          {%- for value in option.values -%}
            <option
              value="{{ value.name | escape }}"
              data-option-value-id="{{ value.id }}"
              data-option-name="{{ option.name | escape }}"
              {% if value.selected %}
                selected
              {% endif %}
            >
              {{- value.name | escape -}}
              {%- unless value.available %} ({{ 'products.product.sold_out' | t }}){% endunless -%}
            </option>
          {%- endfor -%}
        {%- endcapture -%}
        {%- if option_aside != blank -%}
          <div class="variant-picker__option">
            {% render 'select', id: group_name, label: option.name, name: group_name, options_html: value_options %}
            {{ option_aside }}
          </div>
        {%- else -%}
          {% render 'select', id: group_name, label: option.name, name: group_name, options_html: value_options %}
        {%- endif -%}
      {%- else -%}
        {% render 'pill-group', legend: option.name, name: group_name, values: option.values, aside: option_aside %}
      {%- endif -%}
    {%- endfor -%}
  {%- endunless -%}
</variant-picker>
<script src="{{ 'variant-picker.js' | asset_url }}" type="module"></script>
{%- comment -%} Outside the picker, which is re-rendered on every pick. {%- endcomment -%}
{%- if size_guide_shown -%}
  {%- capture size_guide_body -%}{% render 'rte', content: block.settings.size_guide_content %}{%- endcapture -%}
  {% render 'dialog', id: size_guide_id, title: size_guide_heading, content: size_guide_body %}
{%- endif -%}

{% stylesheet %}
  .variant-picker {
    display: grid;
    gap: var(--space-s);
  }

  .variant-picker__option {
    display: grid;
    gap: var(--space-2xs);
    justify-items: start;
  }

  /* Short desktop windows: options sit side by side, so the buy box fits one screen. */
  @media (min-width: 900px) and (max-height: 800px) {
    .variant-picker {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
    }

    .variant-picker > .field,
    .variant-picker__option {
      flex: 1 1 12rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.variant_picker",
  "settings": [
    {
      "type": "select",
      "id": "option_1_style",
      "label": "t:labels.option_1_style",
      "info": "t:info.option_style",
      "options": [
        { "value": "pills", "label": "t:options.option_style.pills" },
        { "value": "dropdown", "label": "t:options.option_style.dropdown" }
      ],
      "default": "pills"
    },
    {
      "type": "select",
      "id": "option_2_style",
      "label": "t:labels.option_2_style",
      "options": [
        { "value": "pills", "label": "t:options.option_style.pills" },
        { "value": "dropdown", "label": "t:options.option_style.dropdown" }
      ],
      "default": "pills"
    },
    {
      "type": "select",
      "id": "option_3_style",
      "label": "t:labels.option_3_style",
      "options": [
        { "value": "pills", "label": "t:options.option_style.pills" },
        { "value": "dropdown", "label": "t:options.option_style.dropdown" }
      ],
      "default": "pills"
    },
    {
      "type": "header",
      "content": "t:general.size_guide"
    },
    {
      "type": "text",
      "id": "size_guide_option",
      "label": "t:labels.size_guide_option",
      "info": "t:info.size_guide_option",
      "default": "Size"
    },
    {
      "type": "text",
      "id": "size_guide_heading",
      "label": "t:labels.heading",
      "default": "Size guide"
    },
    {
      "type": "richtext",
      "id": "size_guide_content",
      "label": "t:labels.content",
      "info": "t:info.size_guide_content"
    }
  ],
  "presets": [{ "name": "t:general.variant_picker" }]
}
{% endschema %}
