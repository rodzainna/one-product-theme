{% comment %}
  The page opened from the gift card email. No header or footer, so its settings are in Theme settings.
{% endcomment %}

{% layout none %}

{%- liquid
  assign is_usable = true
  if gift_card.enabled == false or gift_card.expired
    assign is_usable = false
  endif
-%}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'gift-card.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script src="{{ 'gift-card.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body>
    <main id="MainContent" class="gift-card section-full">
      <div class="gift-card__card">
        {%- if settings.gift_card_logo != blank -%}
          {%- assign logo_file_width = settings.gift_card_logo_max_width | times: 3 -%}
          {%- assign logo_sizes = settings.gift_card_logo_max_width | append: 'px' -%}
          <div
            class="gift-card__logo"
            style="--logo-max-width: {{ settings.gift_card_logo_max_width }}px; --logo-max-height: {{ settings.gift_card_logo_max_height }}px"
          >
            {%- render 'image',
              image: settings.gift_card_logo,
              alt: shop.name,
              width: logo_file_width,
              sizes: logo_sizes,
              loading: 'eager'
            -%}
          </div>
        {%- else -%}
          <p class="gift-card__name">{{ shop.name | escape }}</p>
        {%- endif -%}

        <h1 class="gift-card__balance">{{ gift_card.balance | money }}</h1>

        {%- if gift_card.expired -%}
          <p class="gift-card__notice">{{ 'gift_card.expired' | t }}</p>
        {%- elsif gift_card.enabled == false -%}
          <p class="gift-card__notice">{{ 'gift_card.disabled' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          {%- assign expires_on = gift_card.expires_on | time_tag: format: 'date' -%}
          <p class="gift-card__notice">{{ 'gift_card.expires_on_html' | t: expires_on: expires_on }}</p>
        {%- endif -%}

        {%- if gift_card.message != blank -%}
          <figure class="gift-card__message">
            <figcaption>{{ 'gift_card.message_from_sender' | t }}</figcaption>
            <blockquote>{{ gift_card.message | escape | newline_to_br }}</blockquote>
          </figure>
        {%- endif -%}

        {%- if is_usable -%}
          <p class="gift-card__hint">{{ 'gift_card.use_at_checkout' | t }}</p>
        {%- endif -%}

        <div class="gift-card__code-row">
          <p class="gift-card__code" data-code>
            <span class="visually-hidden">{{ 'gift_card.code' | t }}:</span>
            {{ gift_card.code | format_code }}
          </p>
          {%- assign copy_label = 'gift_card.copy' | t -%}
          {%- capture copy_attributes -%}data-copy="{{ gift_card.code | escape }}"{%- endcapture -%}
          {% render 'icon-button', icon: 'copy', label: copy_label, attributes: copy_attributes %}
          <span
            class="gift-card__copy-status"
            role="status"
            data-copy-status
            data-copied="{{ 'gift_card.copied' | t | escape }}"
            data-failed="{{ 'gift_card.copy_failed' | t | escape }}"
          ></span>
        </div>

        <div
          class="gift-card__qr"
          role="img"
          aria-label="{{ 'gift_card.qr_code' | t }}"
          data-qr="{{ gift_card.qr_identifier | escape }}"
        ></div>

        {%- if gift_card.pass_url -%}
          <a class="gift-card__wallet" href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
              width="180"
              height="60"
            >
          </a>
        {%- endif -%}

        {%- assign back_label = 'gift_card.back_to_shop' | t -%}
        {% render 'button', label: back_label, url: routes.root_url, variant: 'secondary' %}
      </div>
    </main>
  </body>
</html>
